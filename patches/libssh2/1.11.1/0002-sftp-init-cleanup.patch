+/* Dispose of an unfinished init, before its channel is freed. */
+void _libssh2_sftp_init_free(LIBSSH2_SESSION *session)
+{
+    LIBSSH2_SFTP *sftp = session->sftpInit_sftp;
+    if(!sftp)
+        return;
+    sftp_packet_flush(sftp);
+    if(sftp->partial_packet)
+        LIBSSH2_FREE(session, sftp->partial_packet);
+    LIBSSH2_FREE(session, sftp);
+    session->sftpInit_sftp = NULL;
+}
