diff --git a/include/libssh2.h b/include/libssh2.h
index f47858a..51fc11d 100644
--- a/include/libssh2.h
+++ b/include/libssh2.h
@@ -1484,6 +1484,11 @@ LIBSSH2_API void libssh2_keepalive_config(LIBSSH2_SESSION *session,
 LIBSSH2_API int libssh2_keepalive_send(LIBSSH2_SESSION *session,
                                        int *seconds_to_next);
 
+/* Number of keepalive requests awaiting SSH_MSG_REQUEST_SUCCESS/FAILURE.
+ * Only meaningful when keepalive_config() was called with want_reply != 0. */
+LIBSSH2_API unsigned int
+libssh2_keepalive_unanswered(LIBSSH2_SESSION *session);
+
 /* NOTE NOTE NOTE
    libssh2_trace() has no function in builds that aren't built with debug
    enabled
diff --git a/src/keepalive.c b/src/keepalive.c
index 489a1da..8a322fa 100644
--- a/src/keepalive.c
+++ b/src/keepalive.c
@@ -47,11 +47,11 @@ libssh2_keepalive_config(LIBSSH2_SESSION *session,
                          int want_reply,
                          unsigned int interval)
 {
-    if(interval == 1)
-        session->keepalive_interval = 2;
-    else
-        session->keepalive_interval = interval;
+    session->keepalive_interval = interval;
     session->keepalive_want_reply = want_reply ? 1 : 0;
+    session->keepalive_unanswered = 0;
+    /* The first request is due after INTERVAL, not immediately. */
+    session->keepalive_last_sent = time(NULL);
 }
 
 LIBSSH2_API int
@@ -88,6 +88,10 @@ libssh2_keepalive_send(LIBSSH2_SESSION *session,
             return rc;
         }
 
+        if(!rc && session->keepalive_want_reply &&
+           session->keepalive_unanswered < UINT_MAX)
+            session->keepalive_unanswered++;
+
         session->keepalive_last_sent = now;
         if(seconds_to_next)
             *seconds_to_next = session->keepalive_interval;
@@ -99,3 +103,9 @@ libssh2_keepalive_send(LIBSSH2_SESSION *session,
 
     return 0;
 }
+
+LIBSSH2_API unsigned int
+libssh2_keepalive_unanswered(LIBSSH2_SESSION *session)
+{
+    return session ? session->keepalive_unanswered : 0;
+}
