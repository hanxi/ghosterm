+/* Ghosterm pinned extension: distinguish a reported 0 from no status. */
+LIBSSH2_API int
+libssh2_ghosterm_channel_exit_status(LIBSSH2_CHANNEL *channel, int *status)
+{
+    if(!channel || !channel->ghosterm_exit_status_received)
+        return 0;
+    if(channel->ghosterm_exit_status > INT_MAX)
+        return -1;
+    if(status)
+        *status = (int)channel->ghosterm_exit_status;
+    return 1;
+}
