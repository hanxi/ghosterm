+
+const P0Handle = union(enum) {
+    legacy: std.Thread,
+    owned: void,
+    fn detach(self: P0Handle) void {
+        switch (self) { .legacy => |thread| thread.detach(), .owned => {} }
+    }
+};
+fn p0Spawn(t: *Threaded, comptime function: anytype, args: anytype) !P0Handle {
+    if (t.p0_registry) |registry| {
+        try registry.spawn(t.allocator, .{ .stack_size = t.stack_size }, function, args);
+        return .{ .owned = {} };
+    }
+    return .{ .legacy = try std.Thread.spawn(.{ .stack_size = t.stack_size }, function, args) };
+}
+
+pub fn p0SetObserver(t: *Threaded, context: ?*anyopaque, callback: ?P0Registry.Observe) bool {
+    mutexLock(&t.mutex);
+    defer mutexUnlock(&t.mutex);
+    const registry = t.p0_registry orelse return false;
+    if (registry.count != 0) return false;
+    registry.context = context;
+    registry.observe = callback;
+    return true;
+}
+pub fn p0Allocator(t: *Threaded, index: usize) ?std.mem.Allocator {
+    mutexLock(&t.mutex);
+    defer mutexUnlock(&t.mutex);
+    const registry = t.p0_registry orelse return null;
+    if (index >= registry.count) return null;
+    return registry.threads[index].?.argsAllocator();
+}
+pub fn p0Stats(t: *Threaded) P0Registry.Stats {
+    mutexLock(&t.mutex);
+    defer mutexUnlock(&t.mutex);
+    return t.p0_registry.?.stats();
+}
+
+pub fn p0Idle(t: *Threaded) bool {
+    mutexLock(&t.mutex);
+    defer mutexUnlock(&t.mutex);
+    return t.busy_count == 0;
+}
