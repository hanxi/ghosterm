+
+/// Advance animations on the terminal's active screen using the owner's clock.
+/// No timer or thread is created here. UINT64_MAX means no future tick is due.
+pub fn animation_tick(
+    terminal_: terminal_c.Terminal,
+    now_ms: u64,
+    out_changed_: ?*bool,
+    out_delay_ms_: ?*u64,
+) callconv(lib.calling_conv) Result {
+    if (out_changed_) |out| out.* = false;
+    if (out_delay_ms_) |out| out.* = std.math.maxInt(u64);
+    const out_changed = out_changed_ orelse return .invalid_value;
+    const out_delay_ms = out_delay_ms_ orelse return .invalid_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    const before = storage.generation;
+    const next = storage.animationTick(t.io(), now_ms);
+    out_changed.* = storage.generation != before;
+    out_delay_ms.* = next orelse std.math.maxInt(u64);
+    return .success;
+}
 
