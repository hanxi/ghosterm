+// Ghosterm: UI-only erase, never a protocol reset or shell input.
+pub fn clearLocal(terminal_: Terminal) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const t: *ZigTerminal = wrapper.terminal;
+    const screen = t.screens.active;
+    screen.clearSelection();
+    screen.clearRows(.{ .active = .{} }, null, false);
+    screen.eraseHistory(null);
+    if (comptime build_options.kitty_graphics) {
+        screen.kitty_images.delete(t.io(), screen.alloc, t, .{ .all = true });
+    }
+    t.flags.dirty.clear = true;
+    t.scrollViewport(.bottom);
+    return .success;
+}
