+/// Resolve placeholder cells using the same Unicode and geometry implementation
+/// as the full renderer. Also resolves children anchored to virtual placements.
+pub fn virtual_render(
+    terminal_: terminal_c.Terminal,
+    cell_width: u32,
+    cell_height: u32,
+    visit_: ?VirtualRenderFn,
+    context: ?*anyopaque,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const visit = visit_ orelse return .invalid_value;
+    if (cell_width == 0 or cell_height == 0) return .invalid_value;
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    const pages = &t.screens.active.pages;
+    const top = pages.getTopLeft(.viewport);
+    const bottom = pages.getBottomRight(.viewport) orelse return .success;
+    const unicode = @import("../kitty/graphics_unicode.zig");
+    var origins: std.AutoHashMapUnmanaged(kitty_storage.ImageStorage.PlacementKey, struct { x: u32, y: u32 }) = .empty;
+    defer origins.deinit(t.gpa());
+    var iterator = unicode.placementIterator(top, bottom);
+    while (iterator.next()) |p| {
+        const target = storage.placeholderTarget(p.image_id, p.placement_id) orelse continue;
+        const viewport = pages.pointFromPin(.viewport, p.pin) orelse continue;
+        const origin = origins.getOrPut(t.gpa(), target.key) catch return .out_of_memory;
+        if (!origin.found_existing) {
+            origin.value_ptr.* = .{ .x = viewport.viewport.x, .y = viewport.viewport.y };
+        } else {
+            origin.value_ptr.x = @min(origin.value_ptr.x, viewport.viewport.x);
+            origin.value_ptr.y = @min(origin.value_ptr.y, viewport.viewport.y);
+        }
+        const image = storage.images.getPtr(p.image_id) orelse continue;
+        if (image.data.isPending()) continue;
+        const rendered = p.renderPlacement(storage, image, cell_width, cell_height) catch continue;
+        if (rendered.dest_width == 0 or rendered.dest_height == 0) continue;
+        const info: PlacementRenderInfo = .{
+            .pixel_width = rendered.dest_width,
+            .pixel_height = rendered.dest_height,
+            .grid_cols = p.width,
+            .grid_rows = p.height,
+            .viewport_col = @intCast(viewport.viewport.x),
+            .viewport_row = @intCast(viewport.viewport.y),
+            .viewport_visible = true,
+            .source_x = rendered.source_x,
+            .source_y = rendered.source_y,
+            .source_width = rendered.source_width,
+            .source_height = rendered.source_height,
+        };
+        if (!visit(context, p.image_id, target.key.placement_id.id, -1, rendered.offset_x, rendered.offset_y, &info)) return .limit_exceeded;
+    }
+    var placements = storage.placements.iterator();
+    while (placements.next()) |entry| {
+        const p = entry.value_ptr;
+        const relative = switch (p.location) { .relative => |value| value, else => continue };
+        const chain = storage.resolveChain(relative) orelse continue;
+        if (chain.root.location != .virtual) continue;
+        const origin = origins.get(chain.root_key) orelse continue;
+        const image = storage.images.getPtr(entry.key_ptr.image_id) orelse continue;
+        if (image.data.isPending()) continue;
+        const grid = p.gridSize(image.*, t);
+        if (grid.cols == 0 or grid.rows == 0) continue;
+        const x: i64 = @as(i64, origin.x) + chain.horizontal_offset;
+        const y: i64 = @as(i64, origin.y) + chain.vertical_offset;
+        if (x >= t.cols or x + grid.cols - 1 < 0 or y >= t.rows or y + grid.rows - 1 < 0) continue;
+        const pixels = p.pixelSize(image.*, t);
+        const source = p.sourceRect(image.*);
+        const info: PlacementRenderInfo = .{
+            .pixel_width = pixels.width,
+            .pixel_height = pixels.height,
+            .grid_cols = grid.cols,
+            .grid_rows = grid.rows,
+            .viewport_col = std.math.cast(i32, x) orelse continue,
+            .viewport_row = std.math.cast(i32, y) orelse continue,
+            .viewport_visible = true,
+            .source_x = source.x,
+            .source_y = source.y,
+            .source_width = source.width,
+            .source_height = source.height,
+        };
+        if (!visit(context, entry.key_ptr.image_id, entry.key_ptr.placement_id.id, p.z, p.x_offset, p.y_offset, &info)) return .limit_exceeded;
+    }
