diff --git a/include/ghostty/vt/terminal.h b/include/ghostty/vt/terminal.h
--- a/include/ghostty/vt/terminal.h
+++ b/include/ghostty/vt/terminal.h
@@ -3113,6 +3113,11 @@
 /** P0 only: pages must be zero-filled OS mappings, page-aligned, independently
  * decommittable/recommittable; malloc storage is invalid. Both allocator
  * descriptors and contexts must outlive the terminal and derived clones. */
+/* P0 source-owner callback for automatic page pruning under retention limits.
+ * Callback/context are borrowed until replaced or terminal_free, not serialized.
+ * Only record a flag; no terminal calls, UI work, allocation or reentrancy here.
+ * Clear/reset does not report pruning; clone/import does not inherit observers. */
+GHOSTTY_API GhosttyResult ghostty_terminal_p0_set_history_observer(GhosttyTerminal, void*, void (*)(void*));
 GHOSTTY_API GhosttyResult ghostty_terminal_p0_new_with_page_allocator(const GhosttyAllocator*, const GhosttyAllocator*, GhosttyTerminal*, uint16_t, uint16_t);
 /* P0: all resource wire memory uses the required scratch allocator. On failure
  * outputs are NULL/0; on success free via ghostty_free with the same allocator. */
