     }
     try std.testing.expectEqual(pages.allocated_bytes, pages.freed_bytes);
 }
+
+// Source-owner callbacks stay within the lifetime of their PageList.
+const P0HistoryCounter = struct {
+    fn notify(context: ?*anyopaque) callconv(.c) void {
+        const count: *usize = @ptrCast(@alignCast(context.?));count.* += 1;
+    }
+};
+test "p0-history-pruned byte-line-reset" {
+    for ([_]bool{ true, false }) |byte_limit| {
+        var list = try init(std.testing.allocator, .{
+            .cols = 80, .rows = 24,
+            .max_size = if (byte_limit) std_size else null,
+            .max_lines = if (byte_limit) null else @as(usize, 1),
+        });
+        defer list.deinit();
+        var count: usize = 0;list.p0_history_context = &count;list.p0_history_pruned = P0HistoryCounter.notify;
+        const watched = try list.trackPin(list.pin(.{ .screen = .{} }).?);
+        defer list.untrackPin(watched);
+        for (0..2400) |_| { _ = try list.grow(); }
+        try std.testing.expect(count > 0 and watched.garbage and list.total_rows >= list.rows);
+        const before_reset = count;list.reset();
+        try std.testing.expectEqual(before_reset, count);
+        for (0..2400) |_| { _ = try list.grow(); }
+        try std.testing.expect(count > before_reset);
+    }
+}
+test "p0-history-pruned policy-clear" {
+    var list = try init(std.testing.allocator, .{ .cols = 80, .rows = 24 });
+    defer list.deinit();
+    var count: usize = 0;list.p0_history_context = &count;list.p0_history_pruned = P0HistoryCounter.notify;
+    for (0..2400) |_| { _ = try list.grow(); }
+    try std.testing.expectEqual(@as(usize, 0), count);
+    list.setMaxBytes(std_size);
+    try std.testing.expect(count > 0);
+    list.setMaxBytes(null);
+    const before_lines = count;
+    for (0..2400) |_| { _ = try list.grow(); }
+    try std.testing.expectEqual(before_lines, count);
+    list.setMaxLines(1);
+    try std.testing.expect(count > before_lines);
+    const before_reset = count;list.reset();
+    try std.testing.expectEqual(before_reset, count);
+}
+test "p0-history-pruned clone-isolation" {
+    var source = try init(std.testing.allocator, .{ .cols = 80, .rows = 24, .max_size = std_size });
+    defer source.deinit();
+    var count: usize = 0;source.p0_history_context = &count;source.p0_history_pruned = P0HistoryCounter.notify;
+    var copy = try source.clone(std.testing.allocator, .{ .top = .{ .screen = .{} } });
+    defer copy.deinit();
+    for (0..2400) |_| { _ = try copy.grow(); }
+    try std.testing.expectEqual(@as(usize, 0), count);
+    for (0..2400) |_| { _ = try source.grow(); }
+    try std.testing.expect(count > 0);
+}
diff --git a/src/terminal/c/terminal.zig b/src/terminal/c/terminal.zig
