         };
     };
 
+    return .success;
+}
+
+// Owner-only, low-frequency notification. Explicit clear/reset is not pruning.
+pub fn p0_set_history_observer(terminal_: Terminal, context: ?*anyopaque, observer: ?*const fn (?*anyopaque) callconv(.c) void) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const pages = &wrapper.terminal.screens.get(.primary).?.pages;
+    pages.p0_history_context = if (observer != null) context else null;
+    pages.p0_history_pruned = observer;
     return .success;
 }
 
