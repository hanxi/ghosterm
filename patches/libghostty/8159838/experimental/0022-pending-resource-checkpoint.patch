diff --git a/src/terminal/p0_pending_image.zig b/src/terminal/p0_pending_image.zig
new file mode 100644
index 0000000..031c69e
--- /dev/null
+++ b/src/terminal/p0_pending_image.zig
@@ -0,0 +1,49 @@
+//! Pending pixels belong to an authority producer; no fabricated empty payload.
+const std = @import("std");
+const Terminal = @import("Terminal.zig");
+const Image = @import("kitty/graphics_image.zig").Image;
+const Storage = @import("kitty/graphics_storage.zig").ImageStorage;
+pub fn origin(img: *const Image) u64 {
+    return if (img.p0_pending_origin != 0) img.p0_pending_origin else img.generation;
+}
+pub fn begin(t: *Terminal, id: u32, number: u32, width: u32, height: u32, bpp: u32, external: ?u64) !u64 {
+    if (id == 0 or width == 0 or height == 0 or width > 10000 or height > 10000 or (bpp != 3 and bpp != 4)) return error.InvalidData;
+    if (external) |token| if (token == 0) return error.InvalidData;
+    const count = try std.math.mul(usize, width, height);
+    const len = try std.math.mul(usize, count, bpp);
+    const screen = t.screens.active;
+    if (len > screen.kitty_images.total_limit) return error.LimitExceeded;
+    const token = try screen.kitty_images.addPendingImage(t.io(), t.gpa(), screen, .{
+        .id = id,
+        .number = number,
+        .width = width,
+        .height = height,
+        .format = if (bpp == 3) .rgb else .rgba,
+        .data = .{ .pending = len },
+    });
+    const img = screen.kitty_images.images.getPtr(id).?;
+    if (external) |value| img.p0_pending_origin = value;
+    return if (external) |value| value else token.generation;
+}
+pub fn ready(t: *Terminal, id: u32, token: u64, bytes: []const u8) !bool {
+    if (token == 0) return error.InvalidData;
+    const storage = &t.screens.active.kitty_images;
+    const img = storage.images.getPtr(id) orelse return false;
+    if (img.data != .pending or origin(img) != token) return false;
+    if (bytes.len != img.data.pending) return error.InvalidData;
+    const data = try t.gpa().dupe(u8, bytes);
+    const local: Storage.PendingImage = .{ .id = id, .generation = img.generation };
+    if (!local.complete(storage, t.io(), data)) {
+        t.gpa().free(data);
+        return false;
+    }
+    return true;
+}
+pub fn cancel(t: *Terminal, id: u32, token: u64) !bool {
+    if (token == 0) return error.InvalidData;
+    const storage = &t.screens.active.kitty_images;
+    const img = storage.images.getPtr(id) orelse return false;
+    if (img.data != .pending or origin(img) != token) return false;
+    storage.delete(t.io(), t.gpa(), t, .{ .id = .{ .image_id = id, .delete = true } });
+    return true;
+}
