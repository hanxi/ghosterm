+//! Experimental chunked image state; animation frames and async pending fail closed.
+const std = @import("std");
+const Loading = @import("kitty/graphics_image.zig").LoadingImage;
+const command = @import("kitty/graphics_command.zig");
+const Allocator = std.mem.Allocator;
+const display_unsigned = .{ "image_id", "image_number", "placement_id", "x", "y", "width", "height", "x_offset", "y_offset", "columns", "rows", "parent_id", "parent_placement_id" };
+const display_signed = .{ "horizontal_offset", "vertical_offset", "z" };
+const max_loading_bytes = 400 * 1024 * 1024;
+fn put(w: *std.Io.Writer, value: u64) !void { try w.writeInt(u64, value, .little); }
+fn get(r: *std.Io.Reader) !u64 { return try r.takeInt(u64, .little); }
+fn word(r: *std.Io.Reader) !u32 { return std.math.cast(u32, try get(r)) orelse error.InvalidData; }
+fn flag(r: *std.Io.Reader) !bool { return switch (try get(r)) { 0 => false, 1 => true, else => error.InvalidData }; }
+fn enumeration(comptime T: type, r: *std.Io.Reader) !T { return std.enums.fromInt(T, try word(r)) orelse error.InvalidData; }
+pub fn write(w: *std.Io.Writer, maybe: ?*const Loading) !void {
+    try put(w, @intFromBool(maybe != null));
+    const loading = maybe orelse return;
+    const img = loading.image;
+    if (loading.frame != null or img.animation != null or img.data != .complete or img.data.complete.len != 0 or
+        img.generation != 0 or img.metadata.placement_count != 0 or
+        loading.response.frame != 0 or !std.mem.eql(u8, loading.response.message, "OK")) return error.Unsupported;
+    if (img.width > 10000 or img.height > 10000 or loading.data.items.len > max_loading_bytes) return error.LimitExceeded;
+    if (img.format != .rgb and img.format != .rgba and img.format != .png) return error.Unsupported;
+    try put(w, img.id); try put(w, img.number); try put(w, img.width); try put(w, img.height);
+    try put(w, @as(u32, @intCast(@intFromEnum(img.format)))); try put(w, @as(u32, @intCast(@intFromEnum(img.compression))));
+    try put(w, @as(u64, @intFromBool(img.metadata.transient)) | (@as(u64, @intFromBool(img.metadata.implicit_id)) << 1)); try put(w, @intFromEnum(loading.quiet));
+    try put(w, loading.response.id); try put(w, loading.response.image_number); try put(w, loading.response.placement_id);
+    try put(w, @intFromBool(loading.display != null));
+    if (loading.display) |display| {
+        inline for (display_unsigned) |field| try put(w, @field(display, field));
+        inline for (display_signed) |field| try put(w, @as(u32, @bitCast(@field(display, field))));
+        try put(w, @intFromEnum(display.cursor_movement));
+        try put(w, @intFromBool(display.virtual_placement));
+    }
+    try put(w, loading.data.items.len); try w.writeAll(loading.data.items);
+}
+const View = struct { loading: Loading, bytes: []const u8 };
+fn read(r: *std.Io.Reader, limits: Loading.Limits, max_bytes: usize) !?View {
+    if (!try flag(r)) return null;
+    var loading: Loading = .{
+        .image = .{ .id = try word(r), .number = try word(r), .width = try word(r), .height = try word(r) },
+        .quiet = .no,
+        .temporary_directory = switch (limits.temporary_file) { .enabled => |d| d.directory, .disabled => null },
+    };
+    loading.image.format = try enumeration(command.Transmission.Format, r);
+    if (loading.image.format != .rgb and loading.image.format != .rgba and loading.image.format != .png) return error.InvalidData;
+    loading.image.compression = try enumeration(command.Transmission.Compression, r);
+    const flags = try word(r); if (flags > 3) return error.InvalidData;
+    loading.image.metadata.transient = flags & 1 != 0;
+    loading.image.metadata.implicit_id = flags & 2 != 0;
+    loading.quiet = try enumeration(command.Command.Quiet, r);
+    loading.response.id = try word(r); loading.response.image_number = try word(r); loading.response.placement_id = try word(r);
+    if (try flag(r)) {
+        var display: command.Display = .{};
+        inline for (display_unsigned) |field| @field(display, field) = try word(r);
+        inline for (display_signed) |field| @field(display, field) = @bitCast(try word(r));
+        display.cursor_movement = try enumeration(command.Display.CursorMovement, r);
+        display.virtual_placement = try flag(r);
+        loading.display = display;
+    }
+    const len = std.math.cast(usize, try get(r)) orelse return error.LimitExceeded;
+    if (len > max_loading_bytes or len > max_bytes or loading.image.width > 10000 or loading.image.height > 10000) return error.LimitExceeded;
+    return .{ .loading = loading, .bytes = try r.take(len) };
+}
+pub fn preflight(r: *std.Io.Reader, limits: Loading.Limits, max_bytes: usize) !void { _ = try read(r, limits, max_bytes); }
+pub fn restore(alloc: Allocator, r: *std.Io.Reader, limits: Loading.Limits, max_bytes: usize) !?*Loading {
+    const view = (try read(r, limits, max_bytes)) orelse return null;
+    const loading = try alloc.create(Loading);
+    loading.* = view.loading;
+    errdefer loading.destroy(alloc);
+    try loading.data.appendSlice(alloc, view.bytes);
+    return loading;
+}
