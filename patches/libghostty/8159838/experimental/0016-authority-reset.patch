+fn requestReplicaReset(self: *Surface) !bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    const stamp = self.io.replicaInputStampLocked();
+    self.renderer_state.mutex.unlock(global.io());
+    if (!stamp.valid or stamp.generation == 0) return error.InvalidReplicaState;
+    // This callback only queues a control request; no speculative local reset.
+    // It may query state or synchronously feed an authority event in probes.
+    if (comptime @hasDecl(apprt.Surface, "requestHostAction")) {
+        const accepted = self.rt_surface.requestHostAction(stamp.generation, stamp.sequence, 1) orelse return error.UnsupportedReplicaAction;
+        return accepted;
+    }
+    return error.UnsupportedReplicaAction;
+}
