+// One serial transport owner; decode is off UI and outside the renderer lock.
+// Only a fresh empty replica is admissible, so failure can invalidate this
+// hidden placeholder without replacing any visible stable terminal/view.
+pub fn replicaImportOnce(self: *Termio, generation: u64, sequence: u64, canonical: []const u8, resources: []const u8) !bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    if (!self.replica_dynamic or self.replica_import_attempted or generation == 0 or self.replica_generation != 0 or !self.replicaBudgetHealthy() or self.replica_stream == null or self.replica_stream.?.handler.semantic_failure) {
+        self.renderer_state.mutex.unlock(global.io());
+        return false;
+    }
+    self.replica_import_attempted = true;
+    self.renderer_state.mutex.unlock(global.io());
+    const limit = self.replica_image_storage_limit orelse return false;
+    var reader: std.Io.Reader = .fixed(canonical);
+    var decoded = try terminalpkg.snapshot.decodeExact(self.alloc, global.io(), &reader, .{
+        .p0_page_allocator = self.replica_page_allocator,
+        .max_continuation_bytes = 1024 * 1024,
+        .kitty_image_storage_limit = limit,
+    });
+    defer decoded.deinit(self.alloc);
+    decoded.terminal.?.p0_external_animation_clock = true;
+    try @import("../terminal/p0_resource_snapshot.zig").decodeWithLimit(self.alloc, &decoded.terminal.?, resources, 16 * 1024 * 1024, limit);
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    if (!self.replicaBudgetHealthy()) return false;
+    // The old stream must be destroyed while its old blank terminal is valid.
+    self.replica_stream.?.deinit();
+    self.terminal.deinit(self.alloc);
+    self.terminal = decoded.toOwned();
+    self.replica_stream = .init(.{ .allocator = self.alloc, .handler = .init(&self.terminal), .continuation_max_bytes = 1024 * 1024 });
+    self.replica_resources.failed = &self.replica_stream.?.handler.semantic_failure;
+    var it = self.terminal.screens.all.iterator();
+    while (it.next()) |entry| entry.value.*.kitty_images.image_limits.resource_hooks = &self.replica_resources;
+    const continuation: []const u8 = switch (decoded.continuation) { .ground => &.{}, .bytes => |b| b };
+    self.replica_stream.?.nextSlice(continuation);
+    if (self.replica_stream.?.handler.semantic_failure) return error.ReplicaSemanticFailure;
