 /// Process output from the pty. This is the manual API that users can
 /// call with pty data but it is also called by the read thread when using
 /// an exec subprocess.
+pub fn replicaReadImage(self: *Termio, id: u32, dest: []u8, written: *usize, col: *u32, row: *u32) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const stream = if (self.replica_stream) |*s| s else return false;
+    if (stream.handler.semantic_failure) return false;
+    const screen = self.terminal.screens.active;
+    const image = screen.kitty_images.images.getPtr(id) orelse return false;
+    const bytes = image.renderData().bytes() orelse return false;
+    var it = screen.kitty_images.placements.iterator();
+    var found = false;
+    while (it.next()) |entry| {
+        if (entry.key_ptr.image_id != id) continue;
+        if (found or entry.value_ptr.location != .pin) return false;
+        const point = screen.pages.pointFromPin(.viewport, entry.value_ptr.location.pin.*) orelse return false;
+        col.* = point.viewport.x;
+        row.* = point.viewport.y;
+        found = true;
+    }
+    if (!found) return false;
+    written.* = bytes.len;
+    if (dest.len < bytes.len) return false;
+    @memcpy(dest[0..bytes.len], bytes);
+    return true;
+}
