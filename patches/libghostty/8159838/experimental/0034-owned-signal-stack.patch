+pub const signal_stack_size: usize = @intCast(std.options.signal_stack_size orelse 0);
+const SignalState = struct {
+    previous: std.posix.stack_t = undefined,
+    active: bool = false,
+    fn install(self: *SignalState, buffer: []u8) !void {
+        try std.posix.sigaltstack(&.{ .sp = buffer.ptr, .size = std.math.cast(isize, buffer.len) orelse return error.SignalStackTooLarge, .flags = 0 }, &self.previous);
+        self.active = true;
+    }
+    fn restore(self: *SignalState) !void {
+        if (!self.active) return;
+        // Darwin validates size even for SS_DISABLE; a fresh pthread reports 0.
+        if ((self.previous.flags & std.c.SS.DISABLE) != 0) self.previous.size = @max(self.previous.size, std.c.MINSIGSTKSZ);
+        try std.posix.sigaltstack(&self.previous, null);
+        self.active = false;
+    }
+};
