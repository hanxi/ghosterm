diff --git a/src/terminal/p0_host_clear.zig b/src/terminal/p0_host_clear.zig
new file mode 100644
index 0000000..209ccf8
--- /dev/null
+++ b/src/terminal/p0_host_clear.zig
@@ -0,0 +1,18 @@
+//! Shared host-clear semantics. The authority alone sends prompt repaint input.
+const Terminal = @import("Terminal.zig");
+const options = @import("terminal_options");
+pub const Outcome = enum(u32) { ignored = 0, cleared = 1, redraw = 2 };
+pub fn apply(t: *Terminal, history: bool) Outcome {
+    if (t.screens.active_key == .alternate) return .ignored;
+    t.screens.active.clearSelection();
+    if (history) t.eraseDisplay(.scrollback, false);
+    if (!t.cursorIsAtPrompt()) {
+        if (t.screens.active.cursor.y > 0) t.screens.active.eraseActive(t.screens.active.cursor.y - 1);
+        if (comptime options.kitty_graphics) t.screens.active.kitty_images.delete(
+            t.io(), t.screens.active.alloc, t, .{ .all = true },
+        );
+        return .cleared;
+    }
+    t.eraseDisplay(.complete, false);
+    return .redraw;
+}
