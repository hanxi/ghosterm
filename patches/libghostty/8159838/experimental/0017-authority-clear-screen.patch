+pub fn p0_clear(terminal_: Terminal, history: bool, outcome_: ?*u32) callconv(lib.calling_conv) Result {
+    const outcome = outcome_ orelse return .invalid_value;
+    outcome.* = 0;
+    const wrapper = terminal_ orelse return .invalid_value;
+    if (wrapper.stream.handler.semantic_failure) return .invalid_value;
+    const observed = @import("../p0_host_clear.zig").apply(wrapper.terminal, history);
+    outcome.* = @intFromEnum(observed);
+    if (observed == .redraw) Effects.writePtyTrampoline(&wrapper.stream.handler, &.{0x0c});
+    return .success;
+}
