+fn p0ResourceError(err: anyerror) c_int {
+    return switch (err) { error.OutOfMemory => 2, error.Unsupported => 3, error.LimitExceeded => 4, else => 1 };
+}
+pub fn p0_resources_encode(terminal_: Terminal, max_bytes: usize, ptr: ?[*]u8, len: usize, written_: ?*usize) callconv(lib.calling_conv) c_int {
+    if (comptime !build_options.kitty_graphics) return 3;
+    const written = written_ orelse return 1;
+    written.* = 0;
+    const wrapper = terminal_ orelse return 1;
+    if (ptr == null and len != 0 or wrapper.stream.handler.semantic_failure) return 1;
+    const alloc = wrapper.terminal.gpa();
+    const bytes = @import("../p0_resource_snapshot.zig").encode(alloc, wrapper.terminal, max_bytes) catch |err| return p0ResourceError(err);
+    defer alloc.free(bytes);
+    written.* = bytes.len;
+    if (len < bytes.len) return 5;
+    @memcpy(ptr.?[0..bytes.len], bytes);
+    return 0;
+}
+pub fn p0_resources_decode(terminal_: Terminal, ptr: ?[*]const u8, len: usize, max_bytes: usize) callconv(lib.calling_conv) c_int {
+    if (comptime !build_options.kitty_graphics) return 3;
+    const wrapper = terminal_ orelse return 1;
+    if (ptr == null or wrapper.stream.handler.semantic_failure) return 1;
+    @import("../p0_resource_snapshot.zig").decode(wrapper.terminal.gpa(), wrapper.terminal, ptr.?[0..len], max_bytes) catch |err| return p0ResourceError(err);
+    return 0;
+}
