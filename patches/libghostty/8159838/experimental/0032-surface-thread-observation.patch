+    // P0: inspect live native thread stacks; no pointer enters a checkpoint.
+    export fn ghostty_p0_surface_thread_stack_size() usize {
+        return std.Thread.SpawnConfig.default_stack_size;
+    }
+    export fn ghostty_p0_surface_thread_handle(surface: ?*Surface, role: u32, out: ?*usize) bool {
+        const result = out orelse return false;
+        result.* = 0;
+        if (comptime !builtin.os.tag.isDarwin()) return false;
+        const s = surface orelse return false;
+        const thread = switch (role) {
+            1 => s.core_surface.renderer_thr,
+            2 => s.core_surface.io_thr,
+            else => return false,
+        };
+        result.* = @intFromPtr(thread.getHandle());
+        return true;
+    }
