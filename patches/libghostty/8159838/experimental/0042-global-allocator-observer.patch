diff --git a/src/main_c.zig b/src/main_c.zig
--- a/src/main_c.zig
+++ b/src/main_c.zig
@@ -118,6 +118,12 @@
 pub export fn ghostty_p0_init(argc: usize, argv: [*][*:0]u8, host: ?*const @import("lib/allocator.zig").Allocator) c_int {
     const selected = host orelse return 1;
     return initC(argc, argv, selected.zig());
+}
+
+// Observer only, not a transferable pointer or a lifetime extension.
+pub export fn ghostty_p0_global_allocator() usize {
+    if (p0_global_phase.load(.acquire) != 3) return 0;
+    return @intFromPtr(global.alloc().ptr);
 }
 
 // Caller has destroyed all apps/configs/surfaces and joined their threads.
