+/// Experimental C callback using the exact decoder used by the full engine.
+/// The returned pixel buffer belongs to the caller's allocator.
+pub fn p0_decode_png(
+    userdata: ?*anyopaque,
+    allocator: *const CAllocator,
+    ptr: [*]const u8,
+    len: usize,
+    out: *Image,
+) callconv(lib.calling_conv) bool {
+    _ = userdata;
+    out.* = std.mem.zeroes(Image);
+    const image = terminal_sys.decodePngWuffs(lib.alloc.default(allocator), ptr[0..len]) catch return false;
+    out.* = .{ .width = image.width, .height = image.height, .data = image.data.ptr, .data_len = image.data.len };
+    return true;
+}
