 /// Initialize ghostty global state.
+// Global third-party initialization is process-scoped and not retryable.
+// 0=cold, 1=initializing, 2=legacy, 3=owned, 4=retired, 5=failed.
+var p0_global_phase = std.atomic.Value(u8).init(0);
+
 pub export fn ghostty_init(argc: usize, argv: [*][*:0]u8) c_int {
+    return initC(argc, argv, null);
+}
+
+pub export fn ghostty_p0_init(argc: usize, argv: [*][*:0]u8, host: ?*const @import("lib/allocator.zig").Allocator) c_int {
+    const selected = host orelse return 1;
+    return initC(argc, argv, selected.zig());
+}
+
+// Caller has destroyed all apps/configs/surfaces and joined their threads.
+// Only an owned successful initialization can be retired, exactly once.
+pub export fn ghostty_p0_deinit() bool {
+    if (p0_global_phase.cmpxchgStrong(3, 4, .acq_rel, .acquire) != null) return false;
+    global.deinit();
+    return true;
+}
+
+fn initC(argc: usize, argv: [*][*:0]u8, host_allocator: ?std.mem.Allocator) c_int {
     assert(builtin.link_libc);
-
-    global.init(.{
+    if (p0_global_phase.cmpxchgStrong(0, 1, .acq_rel, .acquire) != null) return 1;
+
+    global.initWithAllocator(.{
         .c = .{
             .argc = argc,
             .argv = argv,
@@ -126,11 +148,13 @@
                 // purposes of initialization.
                 .{ .block = .{ .use_global = true } },
         },
-    }) catch |err| {
+    }, host_allocator) catch |err| {
+        p0_global_phase.store(5, .release);
         std.log.err("failed to initialize ghostty error={}", .{err});
         return 1;
     };
 
+    p0_global_phase.store(if (host_allocator != null) 3 else 2, .release);
     return 0;
 }
 
diff --git a/include/ghostty.h b/include/ghostty.h
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -1280,6 +1280,14 @@
 // Published API
 
 GHOSTTY_API int ghostty_init(uintptr_t, char**);
+// Experimental P0: custom descriptor outlives all globals and every borrower.
+// One initialization attempt per process (including legacy); no retry after
+// failure/teardown. NULL host rejects without consuming the attempt. Before
+// deinit, destroy all apps/configs/surfaces and join all engine threads.
+// Teardown covers allocator-owned globals, not third-party library internals.
+GHOSTTY_API int ghostty_p0_init(uintptr_t, char**, const ghostty_p0_allocator_s*);
+GHOSTTY_API bool ghostty_p0_deinit(void);
+
