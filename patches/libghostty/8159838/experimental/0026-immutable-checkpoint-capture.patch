diff --git a/src/terminal/p0_frozen_checkpoint.zig b/src/terminal/p0_frozen_checkpoint.zig
new file mode 100644
index 0000000..315e2e6
--- /dev/null
+++ b/src/terminal/p0_frozen_checkpoint.zig
@@ -0,0 +1,136 @@
+//! Private P0 immutable capture: no source pointer survives capture.
+const std = @import("std");
+const Terminal = @import("Terminal.zig");
+const Page = @import("page.zig").Page;
+const Node = @import("PageList.zig").Node;
+const Key = @import("ScreenSet.zig").Key;
+const codec = @import("snapshot/main.zig");
+const resources_codec = @import("p0_resource_snapshot.zig");
+const Allocator = std.mem.Allocator;
+const Compressed = struct { metadata: Page, raw_len: usize, encoded: []u8 };
+const Fragment = union(enum) { bytes: []u8, resident: Page, compressed: Compressed };
+const Frozen = @This();
+alloc: Allocator,
+fragments: std.ArrayList(Fragment) = .empty,
+resources: []u8 = &.{},
+copied: usize = 0,
+pages: usize = 0,
+compressed_pages: usize = 0,
+limit: usize,
+
+pub fn destroy(self: *Frozen) void {
+    const alloc = self.alloc;
+    for (self.fragments.items) |fragment| switch (fragment) {
+        .bytes => |bytes| alloc.free(bytes),
+        .resident => |page| alloc.free(page.memory),
+        .compressed => |page| alloc.free(page.encoded),
+    };
+    self.fragments.deinit(alloc);
+    alloc.free(self.resources);
+    alloc.destroy(self);
+}
+fn charge(self: *Frozen, n: usize) !void {
+    if (n > self.limit - self.copied) return error.LimitExceeded;
+    self.copied += n;
+}
+fn flush(self: *Frozen, bytes: *std.Io.Writer.Allocating) !void {
+    if (bytes.written().len == 0) return;
+    try self.charge(bytes.written().len);
+    const owned = try bytes.toOwnedSlice();
+    errdefer self.alloc.free(owned);
+    try self.fragments.append(self.alloc, .{ .bytes = owned });
+}
+fn copyPage(self: *Frozen, node: *const Node, bytes: *std.Io.Writer.Allocating) !void {
+    try self.flush(bytes);
+    switch (node.data) {
+        .resident => |page| {
+            try self.charge(page.memory.len);
+            const memory = try self.alloc.alignedAlloc(u8, .fromByteUnits(std.heap.page_size_min), page.memory.len);
+            errdefer self.alloc.free(memory);
+            const copy = page.cloneBuf(memory);
+            try self.fragments.append(self.alloc, .{ .resident = copy });
+        },
+        .compressed => |page| {
+            try self.charge(page.encoded.len);
+            const encoded = try self.alloc.dupe(u8, page.encoded);
+            errdefer self.alloc.free(encoded);
+            var metadata = page.page;
+            const raw_len = metadata.memory.len;
+            // Metadata contains offsets. Erase its sole source-memory slice.
+            metadata.memory = &.{};
+            try self.fragments.append(self.alloc, .{ .compressed = .{ .metadata = metadata, .raw_len = raw_len, .encoded = encoded } });
+            self.compressed_pages += 1;
+        },
+    }
+    self.pages += 1;
+}
+pub fn capture(alloc: Allocator, t: *Terminal, continuation: codec.Continuation, limit: usize) !*Frozen {
+    try codec.continuation.validate(continuation);
+    const self = try alloc.create(Frozen);
+    self.* = .{ .alloc = alloc, .limit = limit };
+    errdefer self.destroy();
+    var bytes: std.Io.Writer.Allocating = .init(alloc);
+    defer bytes.deinit();
+    var stream: codec.record.Writer = .init(alloc, &bytes.writer);
+    defer stream.deinit();
+    try codec.envelope.encode(stream.writer());
+    try codec.terminal.encode(t, &stream);
+    for ([_]Key{ .primary, .alternate }) |key| {
+        const screen = t.screens.get(key) orelse continue;
+        const first = screen.pages.getTopLeft(.active).node;
+        var count: usize = 0;
+        var it: ?*Node = first;
+        while (it) |node| : (it = node.next) count += 1;
+        try codec.screen.p0_encode_header(screen, key, std.math.cast(u16, count) orelse return error.LimitExceeded, &stream);
+        it = first;
+        while (it) |node| : (it = node.next) try self.copyPage(node, &bytes);
+    }
+    try codec.continuation.encode(continuation, &stream);
+    try codec.checkpoint.encode(.ready, &stream);
+    for ([_]Key{ .primary, .alternate }) |key| {
+        const screen = t.screens.get(key) orelse continue;
+        const first = screen.pages.getTopLeft(.active).node.prev;
+        var count: usize = 0;
+        var it = first;
+        while (it) |node| : (it = node.prev) count += 1;
+        const payload = stream.begin(.history);
+        errdefer stream.cancel();
+        try (codec.history.Header{ .key = key, .page_count = std.math.cast(u32, count) orelse return error.LimitExceeded }).encode(payload);
+        try stream.finish();
+        it = first;
+        while (it) |node| : (it = node.prev) try self.copyPage(node, &bytes);
+    }
+    try codec.checkpoint.encode(.finish, &stream);
+    try self.flush(&bytes);
+    self.resources = try resources_codec.freeze(alloc, t, limit - self.copied);
+    try self.charge(self.resources.len);
+    return self;
+}
+pub const Encoded = struct { canonical: []u8, resources: []u8 };
+pub fn encode(self: *const Frozen, alloc: Allocator, max_wire: usize) !Encoded {
+    var bytes: std.Io.Writer.Allocating = .init(alloc);
+    defer bytes.deinit();
+    var stream: codec.record.Writer = .init(alloc, &bytes.writer);
+    defer stream.deinit();
+    for (self.fragments.items) |fragment| {
+        switch (fragment) {
+            .bytes => |data| try bytes.writer.writeAll(data),
+            .resident => |page| try codec.page.encode(&page, &stream),
+            .compressed => |page| {
+                const memory = try alloc.alignedAlloc(u8, .fromByteUnits(std.heap.page_size_min), page.raw_len);
+                defer alloc.free(memory);
+                var restored = page.metadata;
+                restored.memory = memory;
+                _ = try @import("compress.zig").lz4.decompress(page.encoded, memory);
+                try codec.page.encode(&restored, &stream);
+            },
+        }
+        if (bytes.written().len > max_wire) return error.LimitExceeded;
+    }
+    if (self.resources.len > max_wire - bytes.written().len) return error.LimitExceeded;
+    const canonical = try bytes.toOwnedSlice();
+    errdefer alloc.free(canonical);
+    const resources = try alloc.dupe(u8, self.resources);
+    resources_codec.finalize(resources);
+    return .{ .canonical = canonical, .resources = resources };
+}
