+const P0Frozen = @import("../p0_frozen_checkpoint.zig");
+pub fn p0_freeze(terminal: terminal_c.Terminal, alloc_: ?*const CAllocator, limit: usize, out_: ?*?*P0Frozen) callconv(lib.calling_conv) Result {
+    const out = out_ orelse return .invalid_value;
+    out.* = null;
+    const native = terminal_c.zigTerminal(terminal) orelse return .invalid_value;
+    const provider = alloc_ orelse return .invalid_value;
+    if (terminal.?.stream.handler.semantic_failure) return .invalid_value;
+    const alloc = lib.alloc.default(provider);
+    const continuation = continuationOwned(terminal, alloc);
+    if (continuation.result != .success) return continuation.result;
+    defer alloc.free(continuation.bytes);
+    out.* = P0Frozen.capture(alloc, native, continuationValue(continuation.bytes), limit) catch |err| return mapEncodeError(err, null);
+    return .success;
+}
+pub fn p0_frozen_free(value: ?*P0Frozen) callconv(lib.calling_conv) void {
+    if (value) |frozen| frozen.destroy();
+}
+pub fn p0_frozen_encode(value: ?*const P0Frozen, alloc_: ?*const CAllocator, limit: usize, canonical_: ?*?[*]u8, canonical_len_: ?*usize, resources_: ?*?[*]u8, resources_len_: ?*usize) callconv(lib.calling_conv) Result {
+    const canonical = canonical_ orelse return .invalid_value;
+    const canonical_len = canonical_len_ orelse return .invalid_value;
+    const resources = resources_ orelse return .invalid_value;
+    const resources_len = resources_len_ orelse return .invalid_value;
+    canonical.* = null; canonical_len.* = 0; resources.* = null; resources_len.* = 0;
+    const frozen = value orelse return .invalid_value;
+    const provider = alloc_ orelse return .invalid_value;
+    const encoded = frozen.encode(lib.alloc.default(provider), limit) catch |err| return mapEncodeError(err, null);
+    canonical.* = encoded.canonical.ptr; canonical_len.* = encoded.canonical.len;
+    resources.* = encoded.resources.ptr; resources_len.* = encoded.resources.len;
+    return .success;
+}
