+/// P0 metadata capture uses the exact SCREEN payload encoder, without pages.
+pub fn p0_encode_header(screen: *const TerminalScreen, key: TerminalScreenKey, count: u16, destination: *record.Writer) EncodeError!void {
+    const output = destination.begin(.screen);
+    errdefer destination.cancel();
+    try encodePayload(screen, key, count, output);
+    try destination.finish();
+}
