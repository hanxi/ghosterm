+//! Explicit animation-frame command encoding. Cache generations are rebound by the owner.
+const std = @import("std");
+const Loading = @import("kitty/graphics_image.zig").LoadingImage;
+const command = @import("kitty/graphics_command.zig");
+const transmission_words = .{ "width", "height", "size", "offset", "image_id", "image_number", "placement_id" };
+const frame_words = .{ "x", "y", "create_frame", "edit_frame" };
+fn put(w: *std.Io.Writer, value: u64) !void {
+    try w.writeInt(u64, value, .little);
+}
+fn get(r: *std.Io.Reader) !u64 {
+    return try r.takeInt(u64, .little);
+}
+fn word(r: *std.Io.Reader) !u32 {
+    return std.math.cast(u32, try get(r)) orelse error.InvalidData;
+}
+fn flag(r: *std.Io.Reader) !bool {
+    return switch (try get(r)) {
+        0 => false,
+        1 => true,
+        else => error.InvalidData,
+    };
+}
+fn enumeration(comptime T: type, r: *std.Io.Reader) !T {
+    return std.enums.fromInt(T, try word(r)) orelse error.InvalidData;
+}
+pub fn write(w: *std.Io.Writer, maybe: ?Loading.FrameContext, matched: bool) !void {
+    try put(w, @intFromBool(maybe != null));
+    const context = maybe orelse return;
+    const f = context.cmd;
+    const t = f.transmission;
+    if (t.format_unknown) return error.Unsupported;
+    try put(w, @intFromBool(matched));
+    try put(w, @as(u32, @intCast(@intFromEnum(t.format))));
+    try put(w, @as(u32, @intCast(@intFromEnum(t.medium))));
+    inline for (transmission_words) |field| try put(w, @field(t, field));
+    try put(w, @as(u32, @intCast(@intFromEnum(t.compression))));
+    try put(w, @intFromBool(t.more_chunks));
+    try put(w, @intFromBool(t.usage.transient));
+    inline for (frame_words) |field| try put(w, @field(f, field));
+    try put(w, @as(u32, @bitCast(f.gap_ms)));
+    try put(w, @intFromEnum(f.composition_mode));
+    try put(w, @as(u32, @bitCast(f.background)));
+}
+pub const View = struct { frame: ?Loading.FrameContext = null, matched: bool = false };
+pub fn read(r: *std.Io.Reader) !View {
+    if (!try flag(r)) return .{};
+    const matched = try flag(r);
+    var f: command.AnimationFrameLoading = .{};
+    f.transmission.format = try enumeration(command.Transmission.Format, r);
+    if (f.transmission.format != .rgb and f.transmission.format != .rgba and f.transmission.format != .png) return error.InvalidData;
+    f.transmission.medium = try enumeration(command.Transmission.Medium, r);
+    inline for (transmission_words) |field| @field(f.transmission, field) = try word(r);
+    f.transmission.compression = try enumeration(command.Transmission.Compression, r);
+    f.transmission.more_chunks = try flag(r);
+    f.transmission.usage.transient = try flag(r);
+    inline for (frame_words) |field| @field(f, field) = try word(r);
+    f.gap_ms = @bitCast(try word(r));
+    f.composition_mode = try enumeration(command.CompositionMode, r);
+    f.background = @bitCast(try word(r));
+    if (f.transmission.image_id == 0 and f.transmission.image_number == 0) return error.InvalidData;
+    if (f.transmission.image_id != 0 and f.transmission.image_number != 0) return error.InvalidData;
+    return .{ .frame = .{ .cmd = f, .image_generation = 0 }, .matched = matched };
+}
