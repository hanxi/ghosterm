@@ -0,0 +1,92 @@
+//! Bounded animation metadata and composed frames. No renderer cache identities.
+const std = @import("std");
+const Animation = @import("kitty/graphics_animation.zig").Animation;
+const Allocator = std.mem.Allocator;
+const max_frames = 4096;
+fn put(w: *std.Io.Writer, value: u64) !void {
+    try w.writeInt(u64, value, .little);
+}
+fn get(r: *std.Io.Reader) !u64 {
+    return try r.takeInt(u64, .little);
+}
+fn word(r: *std.Io.Reader) !u32 {
+    return std.math.cast(u32, try get(r)) orelse error.InvalidData;
+}
+fn flag(r: *std.Io.Reader) !bool {
+    return switch (try get(r)) {
+        0 => false,
+        1 => true,
+        else => error.InvalidData,
+    };
+}
+pub fn write(w: *std.Io.Writer, maybe: ?*const Animation, rgba_len: usize) !usize {
+    try put(w, @intFromBool(maybe != null));
+    const anim = maybe orelse return 0;
+    if (anim.frames.items.len > max_frames) return error.LimitExceeded;
+    if (anim.current_index > anim.frames.items.len) return error.InvalidData;
+    try put(w, anim.frames.items.len);
+    try put(w, anim.root_gap_ms);
+    try put(w, anim.current_index);
+    try put(w, @intFromEnum(anim.state));
+    try put(w, anim.max_loops);
+    try put(w, anim.current_loop);
+    try put(w, @intFromBool(anim.frame_shown_at_ms != null));
+    if (anim.frame_shown_at_ms) |at| try put(w, at);
+    var bytes: usize = 0;
+    for (anim.frames.items) |frame| {
+        if (frame.data.len != rgba_len) return error.InvalidData;
+        bytes = try std.math.add(usize, bytes, frame.data.len);
+        try put(w, frame.gap_ms);
+        try put(w, frame.data.len);
+        try w.writeAll(frame.data);
+    }
+    return bytes;
+}
+const Header = struct { count: usize, anim: Animation };
+fn header(r: *std.Io.Reader) !?Header {
+    if (!try flag(r)) return null;
+    const count = std.math.cast(usize, try get(r)) orelse return error.LimitExceeded;
+    if (count > max_frames) return error.LimitExceeded;
+    var anim: Animation = .{ .root_gap_ms = try word(r), .current_index = try word(r) };
+    anim.state = std.enums.fromInt(Animation.State, try word(r)) orelse return error.InvalidData;
+    anim.max_loops = try word(r);
+    anim.current_loop = try word(r);
+    if (try flag(r)) anim.frame_shown_at_ms = try get(r);
+    if (anim.current_index > count) return error.InvalidData;
+    return .{ .count = count, .anim = anim };
+}
+const FrameView = struct { gap: u32, bytes: []const u8 };
+fn readFrame(r: *std.Io.Reader, rgba_len: usize, remaining: usize) !FrameView {
+    const gap = try word(r);
+    const len = std.math.cast(usize, try get(r)) orelse return error.LimitExceeded;
+    if (len != rgba_len) return error.InvalidData;
+    if (len > remaining) return error.LimitExceeded;
+    return .{ .gap = gap, .bytes = try r.take(len) };
+}
+pub fn preflight(r: *std.Io.Reader, rgba_len: usize, max_bytes: usize) !usize {
+    const h = (try header(r)) orelse return 0;
+    var bytes: usize = 0;
+    for (0..h.count) |_| {
+        const f = try readFrame(r, rgba_len, max_bytes - bytes);
+        bytes += f.bytes.len;
+    }
+    return bytes;
+}
+pub fn restore(alloc: Allocator, r: *std.Io.Reader, rgba_len: usize, max_bytes: usize) !?*Animation {
+    const h = (try header(r)) orelse return null;
+    const anim = try alloc.create(Animation);
+    anim.* = h.anim;
+    errdefer {
+        anim.deinit(alloc);
+        alloc.destroy(anim);
+    }
+    var bytes: usize = 0;
+    for (0..h.count) |_| {
+        const f = try readFrame(r, rgba_len, max_bytes - bytes);
+        const data = try alloc.dupe(u8, f.bytes);
+        errdefer alloc.free(data);
+        try anim.frames.append(alloc, .{ .data = data, .gap_ms = f.gap });
+        bytes += data.len;
+    }
+    return anim;
+}
diff --git a/src/terminal/p0_animation_tick.zig b/src/terminal/p0_animation_tick.zig
new file mode 100644
index 0000000..c6c91df
--- /dev/null
+++ b/src/terminal/p0_animation_tick.zig
@@ -0,0 +1,8 @@
+//! One authority clock domain. The GUI renderer never advances a replica itself.
+const Terminal = @import("Terminal.zig");
+pub fn apply(t: *Terminal, now_ms: u64) !?u64 {
+    if (t.p0_animation_tick_ms) |previous| if (now_ms < previous) return error.InvalidClock;
+    const delay = t.screens.active.kitty_images.animationTick(t.io(), now_ms);
+    t.p0_animation_tick_ms = now_ms;
+    return delay;
+}
