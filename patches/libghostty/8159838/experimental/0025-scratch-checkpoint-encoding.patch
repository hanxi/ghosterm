+/// P0: allocate resource wire directly in the caller's bounded scratch scope.
+pub fn p0_resources_encode_alloc(terminal_: Terminal, alloc_: ?*const CAllocator, max_bytes: usize, out_ptr_: ?*?[*]u8, out_len_: ?*usize) callconv(lib.calling_conv) c_int {
+    const out_ptr = out_ptr_ orelse return 1;
+    const out_len = out_len_ orelse return 1;
+    out_ptr.* = null; out_len.* = 0;
+    if (comptime !build_options.kitty_graphics) return 3;
+    const provider = alloc_ orelse return 1;
+    const wrapper = terminal_ orelse return 1;
+    if (wrapper.stream.handler.semantic_failure) return 1;
+    const alloc = lib.alloc.default(provider);
+    const bytes = @import("../p0_resource_snapshot.zig").encode(alloc, wrapper.terminal, max_bytes) catch |err| return p0ResourceError(err);
+    out_ptr.* = bytes.ptr; out_len.* = bytes.len;
+    return 0;
+}
