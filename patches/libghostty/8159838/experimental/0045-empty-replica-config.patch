+
+// No file/CLI bridge for low-frequency checkpoint palette metadata. The caller
+// owns an isolated config clone and finalizes it before surface construction.
+export fn ghostty_p0_config_replica_colors(ptr: ?*Config, dark: bool, bg: Config.Color.C, fg: Config.Color.C) bool {
+    const self = ptr orelse return false;
+    self.theme = null;
+    self.background = .{ .r = bg.r, .g = bg.g, .b = bg.b };
+    self.foreground = .{ .r = fg.r, .g = fg.g, .b = fg.b };
+    self.@"cursor-color" = null;
+    self._conditional_state.theme = if (dark) .dark else .light;
+    return true;
 }
 
