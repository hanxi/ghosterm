+const Target = struct { screen: *@import("Screen.zig"), id: u32 };
+// Authority origins are global; active-screen changes never retarget a producer.
+fn find(t: *Terminal, token: u64) !?Target {
+    var found: ?Target = null;
+    var screens = t.screens.all.iterator();
+    while (screens.next()) |entry| {
+        const screen = entry.value.*;
+        var images = screen.kitty_images.images.valueIterator();
+        while (images.next()) |img| {
+            if (img.data != .pending or origin(img) != token) continue;
+            if (found != null) return error.InvalidData;
+            found = .{ .screen = screen, .id = img.id };
+        }
+    }
+    return found;
+}
