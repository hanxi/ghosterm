+pub fn p0_resource_hooks(
+    terminal_: Terminal,
+    userdata: ?*anyopaque,
+    observe: ?@import("../kitty/graphics_image.zig").LoadingImage.ResourceHooks.Observe,
+    resolve: ?@import("../kitty/graphics_image.zig").LoadingImage.ResourceHooks.Resolve,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    if (comptime !build_options.kitty_graphics) return .invalid_value;
+    if ((observe == null) == (resolve == null)) return .invalid_value;
+    if (wrapper.resource_hooks.observe != null or wrapper.resource_hooks.resolve != null) return .invalid_value;
+    wrapper.resource_hooks = .{
+        .userdata = userdata,
+        .observe = observe,
+        .resolve = resolve,
+        .failed = &wrapper.stream.handler.semantic_failure,
+    };
+    var it = wrapper.terminal.screens.all.iterator();
+    while (it.next()) |entry| entry.value.*.kitty_images.image_limits.resource_hooks = &wrapper.resource_hooks;
+    return .success;
+}
