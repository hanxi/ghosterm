+/* P0 experimental resource events. Medium: 1=file, 2=temp, 3=shared.
+ * Status: 0=bytes, 1=source load rejected. Callbacks are synchronous.
+ * Paths/payloads are borrowed byte buffers. Resolve payload must remain valid
+ * through the current feed. Set once, before input; exactly one callback.
+ * Callback rejection sets sticky VT_PROCESSING_ERROR. No filesystem fallback.
+ */
+typedef bool (*GhosttyP0ResourceObserveFn)(void*, uint32_t, const uint8_t*, size_t,
+                                        uint32_t, const uint8_t*, size_t);
+typedef bool (*GhosttyP0ResourceResolveFn)(void*, uint32_t, const uint8_t*, size_t,
+                                        uint32_t*, const uint8_t**, size_t*);
+GHOSTTY_API GhosttyResult ghostty_terminal_p0_resource_hooks(
+    GhosttyTerminal, void*, GhosttyP0ResourceObserveFn, GhosttyP0ResourceResolveFn);
+
