+// Experimental observation point: export the actual full-surface resource graph.
+// This is not a production checkpoint API; canonical/resource capture is separate.
+pub fn replicaResourcesSnapshot(self: *Termio, dest: []u8, written: *usize) !bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const stream = if (self.replica_stream) |*s| s else return error.NotReplica;
+    if (stream.handler.semantic_failure) return error.ReplicaSemanticFailure;
+    const bytes = try @import("../terminal/p0_resource_snapshot.zig").encode(self.alloc, &self.terminal, 16 * 1024 * 1024);
+    defer self.alloc.free(bytes);
+    written.* = bytes.len;
+    if (dest.len < bytes.len) return false;
+    @memcpy(dest[0..bytes.len], bytes);
+    return true;
+}
