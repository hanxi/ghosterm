diff --git a/src/apprt/p0_io_threads.zig b/src/apprt/p0_io_threads.zig
new file mode 100644
--- /dev/null
+++ b/src/apprt/p0_io_threads.zig
@@ -0,0 +1,43 @@
+// Experimental P0 global-I/O workers. Spawn runs under Threaded.mutex.
+// Threaded.deinit only waits for worker() to finish; explicit pthread joins
+// also wait for the outer entry frame and registered signal stack to retire.
+const std = @import("std");
+const Owned = @import("p0_thread.zig");
+const Self = @This();
+pub const limit: usize = 2;
+pub const stack_size: usize = 16 * 1024 * 1024;
+pub const Observe = *const fn (?*anyopaque, u32, u32) callconv(.c) void;
+pub const Stats = extern struct { threads: usize, started: usize, finished: usize, joined: usize, failures: usize, stack: usize };
+threads: [limit]?Owned.Thread = @splat(null),
+count: usize = 0,
+joined: usize = 0,
+started: std.atomic.Value(usize) = .init(0),
+finished: std.atomic.Value(usize) = .init(0),
+failures: std.atomic.Value(usize) = .init(0),
+context: ?*anyopaque = null,
+observe: ?Observe = null,
+pub fn spawn(self: *Self, allocator: std.mem.Allocator, config: std.Thread.SpawnConfig, comptime function: anytype, args: anytype) !void {
+    if (self.count >= limit) { _ = self.failures.fetchAdd(1, .acq_rel);return error.ThreadLimit; }
+    const Wrapper = struct {
+        fn run(owner: *Self, index: usize, values: @TypeOf(args)) void {
+            _ = owner.started.fetchAdd(1, .acq_rel);
+            if (owner.observe) |observe| observe(owner.context, @intCast(index), 0);
+            @call(.auto, function, values);
+            if (owner.observe) |observe| observe(owner.context, @intCast(index), 1);
+            _ = owner.finished.fetchAdd(1, .acq_rel);
+        }
+    };
+    const thread = Owned.spawn(allocator, config, Wrapper.run, .{self, self.count, args}) catch |err| {
+        _ = self.failures.fetchAdd(1, .acq_rel);return err;
+    };
+    self.threads[self.count] = thread;
+    self.count += 1;
+}
+pub fn join(self: *Self) void {
+    for (self.threads[0..self.count]) |thread| { thread.?.join();self.joined += 1; }
+    self.count = 0;
+    self.threads = @splat(null);
+}
+pub fn stats(self: *const Self) Stats {
+    return .{ .threads = self.count, .started = self.started.load(.acquire), .finished = self.finished.load(.acquire), .joined = self.joined, .failures = self.failures.load(.acquire), .stack = stack_size };
+}
