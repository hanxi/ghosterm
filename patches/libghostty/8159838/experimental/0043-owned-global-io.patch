+pub export fn ghostty_p0_global_io_stats(output: ?*P0IoThreads.Stats) bool {
+    const out = output orelse return false;
+    const phase = p0_global_phase.load(.acquire);
+    if (phase == 3) { out.* = global.p0IoImpl().p0Stats();return true; }
+    if (phase == 4 and p0_io_retired.load(.acquire)) { out.* = global.p0IoStats();return true; }
+    return false;
+}
+// Experimental integration exercise, not a production session API. The caller
+// independently observes real pthreads, allocator ranges and final reclamation.
+const P0IoProbeWork = struct {
+    stop: std.atomic.Value(bool) = .init(false),
+    entered: std.atomic.Value(usize) = .init(0),
+    quick: std.atomic.Value(usize) = .init(0),
+    timed_out: std.atomic.Value(bool) = .init(false),
+    extern "c" fn usleep(u32) c_int;
+    fn run(self: *@This()) usize {
+        _ = self.entered.fetchAdd(1, .acq_rel);
+        var tries: usize = 0;
+        while (!self.stop.load(.acquire) and tries < 2000) : (tries += 1) global.io().sleep(.fromMilliseconds(1), .awake) catch { self.timed_out.store(true, .release);return 0; };
+        if (!self.stop.load(.acquire)) self.timed_out.store(true, .release);
+        return 1;
+    }
+    fn group(self: *@This()) void { _ = self.run(); }
+    fn fast(self: *@This()) usize { _ = self.quick.fetchAdd(1, .acq_rel);return 1; }
+    fn fastGroup(self: *@This()) void { _ = self.fast(); }
+    fn idle() bool {
+        var tries: usize = 0;
+        while (!global.p0IoImpl().p0Idle() and tries < 2000) : (tries += 1) _ = usleep(1000);
+        return global.p0IoImpl().p0Idle();
+    }
+    fn ready(self: *@This()) bool {
+        var tries: usize = 0;
+        while (self.entered.load(.acquire) != 2 and tries < 2000) : (tries += 1) _ = usleep(1000);
+        return self.entered.load(.acquire) == 2 and !self.timed_out.load(.acquire);
+    }
+};
+const P0IoCancel = struct {
+    fn run(io: std.Io, entered: *std.atomic.Value(bool)) bool {
+        entered.store(true, .release);
+        io.sleep(.fromSeconds(3), .awake) catch |err| return err == error.Canceled;
+        return false;
+    }
+};
+pub export fn ghostty_p0_global_io_probe(kind: u32) bool {
+    if (p0_global_phase.load(.acquire) != 3 or kind > 4) return false;
+    const io = global.io();
+    if (!P0IoProbeWork.idle()) return false;
+    if (kind == 4) {
+        var entered = std.atomic.Value(bool).init(false);
+        var future = io.concurrent(P0IoCancel.run, .{io, &entered}) catch return false;
+        var tries: usize = 0;
+        while (!entered.load(.acquire) and tries < 2000) : (tries += 1) _ = P0IoProbeWork.usleep(1000);
+        return future.cancel(io) and entered.load(.acquire) and P0IoProbeWork.idle();
+    }
+    var work = P0IoProbeWork{};
+    const asynchronous = (kind & 1) != 0;
+    if (kind < 2) {
+        var first = if (asynchronous) io.async(P0IoProbeWork.run, .{&work}) else io.concurrent(P0IoProbeWork.run, .{&work}) catch return false;
+        defer { work.stop.store(true, .release);_ = first.await(io); }
+        var second = if (asynchronous) io.async(P0IoProbeWork.run, .{&work}) else io.concurrent(P0IoProbeWork.run, .{&work}) catch return false;
+        defer { work.stop.store(true, .release);_ = second.await(io); }
+        if (!work.ready()) return false;
+        if (asynchronous) {
+            var third = io.async(P0IoProbeWork.fast, .{&work});
+            const inline_result = third.any_future == null;
+            _ = third.await(io);
+            if (!inline_result or work.quick.load(.acquire) != 1) return false;
+        } else {
+            if (io.concurrent(P0IoProbeWork.fast, .{&work})) |value| {
+                var unexpected = value;_ = unexpected.await(io);return false;
+            } else |err| if (err != error.ConcurrencyUnavailable) return false;
+            if (work.quick.load(.acquire) != 0) return false;
+        }
+        work.stop.store(true, .release);
+        return first.await(io) == 1 and second.await(io) == 1 and !work.timed_out.load(.acquire) and P0IoProbeWork.idle();
+    }
+    var group: std.Io.Group = .init;
+    defer { work.stop.store(true, .release);group.await(io) catch {}; }
+    if (asynchronous) {
+        group.async(io, P0IoProbeWork.group, .{&work});
+        group.async(io, P0IoProbeWork.group, .{&work});
+    } else {
+        group.concurrent(io, P0IoProbeWork.group, .{&work}) catch return false;
+        group.concurrent(io, P0IoProbeWork.group, .{&work}) catch return false;
+    }
+    if (!work.ready()) return false;
+    if (asynchronous) {
+        group.async(io, P0IoProbeWork.fastGroup, .{&work});
+        if (work.quick.load(.acquire) != 1) return false;
+    } else {
+        if (group.concurrent(io, P0IoProbeWork.fastGroup, .{&work})) |_| return false else |err| if (err != error.ConcurrencyUnavailable) return false;
+        if (work.quick.load(.acquire) != 0) return false;
+    }
+    work.stop.store(true, .release);
+    group.await(io) catch return false;
+    return !work.timed_out.load(.acquire) and P0IoProbeWork.idle();
+}
