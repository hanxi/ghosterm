+const P0IoThreads = @import("apprt/p0_io_threads.zig");
+pub export fn ghostty_p0_global_io_thread_limit() usize { return P0IoThreads.limit; }
+pub export fn ghostty_p0_global_io_thread_stack_size() usize { return P0IoThreads.stack_size; }
