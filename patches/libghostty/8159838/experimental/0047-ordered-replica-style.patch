@@ -189,6 +189,11 @@
 pub fn updateConfig(self: *App, rt_app: *apprt.App, config: *const Config) !void {
     // Go through and update all of the surface configurations.
     for (self.surfaces.items) |surface| {
+        // A replica accepts configuration only at its Source sequence barrier.
+        // Updating it here would publish an unsequenced authority mutation.
+        if (comptime @hasDecl(apprt.Surface, "replicaEmpty")) {
+            if (surface.replicaEmpty()) continue;
+        }
         try surface.core().handleMessage(.{ .change_config = config });
     }
 
diff --git a/src/config/CApi.zig b/src/config/CApi.zig
--- a/src/config/CApi.zig
+++ b/src/config/CApi.zig
@@ -67,6 +67,39 @@
     self.background = .{ .r = bg.r, .g = bg.g, .b = bg.b };
     self.foreground = .{ .r = fg.r, .g = fg.g, .b = fg.b };
     self.@"cursor-color" = null;
+    self._conditional_state.theme = if (dark) .dark else .light;
+    return true;
+}
+
+// Explicit 777 RGB bytes: background, foreground, cursor and 256 palette entries.
+// Resolve the requested conditional theme without changing the application's config.
+export fn ghostty_p0_config_style(ptr: ?*Config, dark: bool, out: ?[*]u8) bool {
+    const self = ptr orelse return false;
+    const bytes = out orelse return false;
+    var state = self._conditional_state;
+    state.theme = if (dark) .dark else .light;
+    var applied = self.changeConditionalState(state) catch return false;
+    defer if (applied) |*c| c.deinit();
+    const config: *const Config = if (applied) |*c| c else self;
+    const cursor: Config.Color = if (config.@"cursor-color") |c| switch (c) {
+        .color => |rgb| rgb,
+        .@"cell-foreground" => config.foreground,
+        .@"cell-background" => config.background,
+    } else config.foreground;
+    const colors = [_]Config.Color{ config.background, config.foreground, cursor };
+    for (colors, 0..) |color, i| { bytes[i*3] = color.r; bytes[i*3+1] = color.g; bytes[i*3+2] = color.b; }
+    for (config.palette.value, 0..) |color, i| { bytes[9+i*3] = color.r; bytes[10+i*3] = color.g; bytes[11+i*3] = color.b; }
+    return true;
+}
+export fn ghostty_p0_config_replica_style(ptr: ?*Config, dark: bool, input: ?[*]const u8) bool {
+    const self = ptr orelse return false;
+    const bytes = input orelse return false;
+    self.theme = null;
+    self.background = .{ .r=bytes[0], .g=bytes[1], .b=bytes[2] };
+    self.foreground = .{ .r=bytes[3], .g=bytes[4], .b=bytes[5] };
+    self.@"cursor-color" = .{ .color = .{ .r=bytes[6], .g=bytes[7], .b=bytes[8] } };
+    for (&self.palette.value, 0..) |*color, i| color.* = .{ .r=bytes[9+i*3], .g=bytes[10+i*3], .b=bytes[11+i*3] };
+    self.palette.mask = .initFull();
     self._conditional_state.theme = if (dark) .dark else .light;
     return true;
 }
