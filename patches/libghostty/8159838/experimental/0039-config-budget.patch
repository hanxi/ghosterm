+
+/// Experimental P0 regular-file path: bounded staging prevents iterator read
+/// errors from being silently mistaken for end-of-file. All staging is charged
+/// to the supplied owner; legacy streaming loadFile keeps its original contract.
+pub fn loadFileStrict(self: *Config, alloc: Allocator, path: []const u8) !void {
+    var file = file_load.open(global.io(), path) catch |err| switch (err) {
+        error.FileIsEmpty => return,
+        else => return err,
+    };
+    defer file.close(global.io());
+    var buffer: [2048]u8 = undefined;
+    var file_reader = file.reader(global.io(), &buffer);
+    // Reader's bounded allocation rejects when the limit is reached, so one
+    // extra probe byte distinguishes an exactly-full file from an oversized one.
+    const max_bytes = 1024 * 1024;
+    const content = try file_reader.interface.allocRemaining(alloc, .limited(max_bytes + 1));
+    defer alloc.free(content);
+    if (content.len > max_bytes) return error.StreamTooLong;
+    const text = if (std.mem.startsWith(u8, content, "\xef\xbb\xbf")) content[3..] else content;
+    var lines = std.mem.splitScalar(u8, text, '\n');
+    while (lines.next()) |line| {
+        if (line.len > cli.args.LineIterator.MAX_LINE_SIZE - 2) return error.ConfigLineTooLong;
+    }
+    var memory_reader = std.Io.Reader.fixed(content);
+    try self.loadReader(alloc, &memory_reader, path);
 }
 
