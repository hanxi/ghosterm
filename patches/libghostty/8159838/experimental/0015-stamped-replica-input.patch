+/// Input was encoded against this exact mode stamp. Do not re-read modes here.
+pub fn queueWriteInput(self: *Host, data: []const u8, stamp: termio.Message.InputStamp) !void {
+    const callback = self.callbacks.write_input orelse return error.MissingReplicaInputCallback;
+    if (!stamp.linefeed) {
+        callback(self.callbacks.userdata, stamp.generation, stamp.sequence, data.ptr, data.len);
+        return;
+    }
+    var buf: [4096]u8 = undefined;
+    var i: usize = 0;
+    while (i < data.len) {
+        var n: usize = 0;
+        while (i < data.len and n < buf.len - 1) {
+            const ch = data[i]; i += 1;
+            buf[n] = ch; n += 1;
+            if (ch == '\r') { buf[n] = '\n'; n += 1; }
+        }
+        if (n > 0) callback(self.callbacks.userdata, stamp.generation, stamp.sequence, &buf, n);
+    }
+}
