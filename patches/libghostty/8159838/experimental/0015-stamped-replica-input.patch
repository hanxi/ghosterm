+// Caller holds renderer_state.mutex: mode options and this stamp share a cut.
+pub fn replicaInputStampLocked(self: *const Termio) termio.Message.InputStamp {
+    return .{
+        .generation = self.replica_generation,
+        .sequence = self.replica_sequence,
+        .linefeed = self.terminal.modes.get(.linefeed),
+        .valid = if (self.replica_stream) |stream| !stream.handler.semantic_failure else false,
+    };
+}
+
+pub fn queueReplicaInput(self: *Termio, request: termio.Message.ReplicaWrite) !void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    const stream = if (self.replica_stream) |*s| s else {
+        self.renderer_state.mutex.unlock(global.io());
+        return error.NotReplica;
+    };
+    const stamp = request.stamp;
+    if (stream.handler.semantic_failure or !stamp.valid or stamp.generation == 0 or
+        stamp.generation != self.replica_generation or stamp.sequence < self.replica_start_sequence or stamp.sequence > self.replica_sequence or
+        self.backend != .host or self.backend.host.callbacks.write_input == null)
+    {
+        stream.handler.semantic_failure = true;
+        self.renderer_state.mutex.unlock(global.io());
+        return error.InvalidReplicaInput;
+    }
+    // The callback may feed new authority output; never invoke it under this lock.
+    self.renderer_state.mutex.unlock(global.io());
+    try self.backend.host.queueWriteInput(request.data.slice(), stamp);
+}
