new file mode 100644
--- /dev/null
+++ b/src/apprt/p0_thread.zig
@@ -0,0 +1,103 @@
+// P0 Darwin budgeted pthread entry frames. The std POSIX spawn path uses
+// c_allocator even when SpawnConfig.allocator is set. Preserve its stack,
+// guard and signal-stack setup; only the entry frame uses the host domain.
+const std = @import("std");
+const builtin = @import("builtin");
+pub const Thread = union(enum) {
+    standard: std.Thread,
+    bounded: if (builtin.os.tag.isDarwin()) struct { handle: std.c.pthread_t, allocator: std.mem.Allocator } else void,
+    pub fn getHandle(self: Thread) std.Thread.Handle {
+        return switch (self) {
+            .standard => |t| t.getHandle(),
+            .bounded => |h| if (comptime builtin.os.tag.isDarwin()) h.handle else unreachable,
+        };
+    }
+    pub fn argsAllocator(self: Thread) ?std.mem.Allocator {
+        return switch (self) {
+            .standard => null,
+            .bounded => |h| if (comptime builtin.os.tag.isDarwin()) h.allocator else null,
+        };
+    }
+    pub fn join(self: Thread) void {
+        switch (self) {
+            .standard => |t| t.join(),
+            .bounded => |h| if (comptime builtin.os.tag.isDarwin()) {
+                std.debug.assert(std.c.pthread_join(h.handle, null) == .SUCCESS);
+            } else unreachable,
+        }
+    }
+    pub fn setName(self: Thread, io: std.Io, name: []const u8) !void {
+        switch (self) {
+            .standard => |t| try t.setName(io, name),
+            .bounded => |h| if (comptime builtin.os.tag.isDarwin()) {
+                if (h.handle != std.c.pthread_self()) return error.Unsupported;
+                var buffer: [64]u8 = undefined;
+                const text = std.fmt.bufPrintZ(&buffer, "{s}", .{name}) catch return error.NameTooLong;
+                if (std.c.pthread_setname_np(text.ptr) != 0) return error.SystemResources;
+            } else return error.Unsupported,
+        }
+    }
+};
+pub fn spawn(allocator: std.mem.Allocator, config: std.Thread.SpawnConfig, comptime function: anytype, args: anytype) !Thread {
+    if (comptime !builtin.os.tag.isDarwin() or !builtin.link_libc) return error.UnsupportedThreadAllocator;
+    if (@typeInfo(@TypeOf(function)).@"fn".return_type.? != void) @compileError("P0 engine thread entry must return void");
+    const Frame = struct { allocator: std.mem.Allocator, args: @TypeOf(args) };
+    const Entry = struct {
+        fn run(raw: ?*anyopaque) callconv(.c) ?*anyopaque {
+            const frame: *Frame = @ptrCast(@alignCast(raw.?));
+            const owner = frame.allocator;
+            defer owner.destroy(frame);
+            std.Thread.maybeAttachSignalStack();
+            @call(.auto, function, frame.args);
+            return null;
+        }
+    };
+    const owner_allocator = allocator;
+    const frame = try owner_allocator.create(Frame);
+    errdefer owner_allocator.destroy(frame);
+    frame.* = .{ .allocator = owner_allocator, .args = args };
+    var attr: std.c.pthread_attr_t = undefined;
+    if (std.c.pthread_attr_init(&attr) != .SUCCESS) return error.SystemResources;
+    defer std.debug.assert(std.c.pthread_attr_destroy(&attr) == .SUCCESS);
+    if (std.c.pthread_attr_setstacksize(&attr, @max(config.stack_size, 16 * 1024)) != .SUCCESS) return error.SystemResources;
+    if (std.c.pthread_attr_setguardsize(&attr, std.heap.pageSize()) != .SUCCESS) return error.SystemResources;
+    var handle: std.c.pthread_t = undefined;
+    if (std.c.pthread_create(&handle, &attr, Entry.run, @ptrCast(frame)) != .SUCCESS) return error.SystemResources;
+    return .{ .bounded = .{ .handle = handle, .allocator = owner_allocator } };
+}
+
+test "successful entry uses selected allocator" {
+    const Job = struct { fn run(value: *std.atomic.Value(u32)) void { _ = value.fetchAdd(1, .seq_cst); } };
+    var value = std.atomic.Value(u32).init(0);
+    const thread = try spawn(std.testing.allocator, .{}, Job.run, .{&value});
+    const owner = thread.argsAllocator().?;
+    thread.join();
+    try std.testing.expectEqual(std.testing.allocator.ptr, owner.ptr);
+    try std.testing.expectEqual(@as(u32, 1), value.load(.seq_cst));
+}
+test "entry allocation denial creates no thread" {
+    const Job = struct { fn run(value: *std.atomic.Value(u32)) void { _ = value.fetchAdd(1, .seq_cst); } };
+    var value = std.atomic.Value(u32).init(0);
+    var failing = std.testing.FailingAllocator.init(std.testing.allocator, .{ .fail_index = 0 });
+    try std.testing.expectError(error.OutOfMemory, spawn(failing.allocator(), .{}, Job.run, .{&value}));
+    try std.testing.expectEqual(@as(u32, 0), value.load(.seq_cst));
+}
+test "startup error releases allocated entry" {
+    const Job = struct { fn run(value: *std.atomic.Value(u32)) void { _ = value.fetchAdd(1, .seq_cst); } };
+    var value = std.atomic.Value(u32).init(0);
+    try std.testing.expectError(error.SystemResources, spawn(std.testing.allocator, .{ .stack_size = std.math.maxInt(usize) }, Job.run, .{&value}));
+    try std.testing.expectEqual(@as(u32, 0), value.load(.seq_cst));
+}
+test "signal stack setup is preserved" {
+    const Job = struct {
+        fn run(result: *bool) void {
+            var stack: std.posix.stack_t = undefined;
+            std.posix.sigaltstack(null, &stack) catch { result.* = false;return; };
+            result.* = stack.size >= (std.options.signal_stack_size orelse std.math.maxInt(u64));
+        }
+    };
+    var result = false;
+    const thread = try spawn(std.testing.allocator, .{}, Job.run, .{&result});
+    thread.join();
+    try std.testing.expect(result);
+}
