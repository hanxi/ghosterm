+    // P0: actual allocator descriptor selected for each bounded entry frame.
+    export fn ghostty_p0_surface_thread_args_allocator(surface: ?*Surface, role: u32, out: ?*usize) bool {
+        const result = out orelse return false;result.* = 0;
+        const s = surface orelse return false;
+        const allocator = switch (role) {
+            1 => s.core_surface.renderer_thr.argsAllocator(),
+            2 => s.core_surface.io_thr.argsAllocator(),
+            else => return false,
+        } orelse return false;
+        result.* = @intFromPtr(allocator.ptr);return true;
+    }
