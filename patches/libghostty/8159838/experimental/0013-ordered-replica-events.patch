+
+    export fn ghostty_p0_surface_event_resize(surface: *Surface, sequence: u64, cols: u16, rows: u16, width: u32, height: u32) bool {
+        const invalid = cols == 0 or rows == 0 or width == 0 or height == 0 or
+            @as(u64, cols) * rows > 1024 * 1024 or
+            @as(u64, cols) * width > std.math.maxInt(u32) or
+            @as(u64, rows) * height > std.math.maxInt(u32);
+        if (invalid) return false;
+        return surface.core_surface.io.replicaEvent(sequence, .{ .resize = .{ .cols = cols, .rows = rows, .width = width, .height = height } });
+    }
+
+    export fn ghostty_p0_surface_applied_sequence(surface: *Surface, sequence: *u64) bool {
+        sequence.* = 0;
+        return surface.core_surface.io.replicaAppliedSequence(sequence);
+    }
