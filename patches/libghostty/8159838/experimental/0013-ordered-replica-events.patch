+pub const ReplicaEvent = union(enum) {
+    output: []const u8,
+    resize: struct { cols: u16, rows: u16, width: u32, height: u32 },
+};
+
+// Acceptance means the parser/grid has applied this event under the same lock
+// used for input-mode reads. It does not acknowledge rendering or an IPC read.
+pub fn replicaEvent(self: *Termio, sequence: u64, event: ReplicaEvent) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const stream = if (self.replica_stream) |*s| s else return false;
+    if (stream.handler.semantic_failure) return false;
+    if (self.replica_sequence == std.math.maxInt(u64) or sequence != self.replica_sequence + 1) return false;
+    switch (event) {
+        .output => |bytes| stream.nextSlice(bytes),
+        .resize => |size| self.terminal.resize(self.alloc, .{
+            .cols = size.cols, .rows = size.rows,
+            .cell_size_px = .{ .width = size.width, .height = size.height },
+        }) catch {
+            // A failed resize can have partially changed page state. Invalidate
+            // this replica rather than exporting a plausible partial result.
+            stream.handler.semantic_failure = true;
+            return false;
+        },
+    }
+    if (stream.handler.semantic_failure) return false;
+    self.replica_sequence = sequence;
+    self.renderer_wakeup.notify() catch {};
+    return true;
+}
+
+pub fn replicaAppliedSequence(self: *Termio, sequence: *u64) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const stream = if (self.replica_stream) |*s| s else return false;
+    if (stream.handler.semantic_failure) return false;
+    sequence.* = self.replica_sequence;
+    return true;
+}
