+
+// Admission only: sequence stays at the previously applied event until the
+// exact tagged change_config message has updated the terminal under this lock.
+pub fn replicaSchemeBegin(self: *Termio, generation: u64, sequence: u64, dark: bool) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const stream = if (self.replica_stream) |*s| s else return false;
+    if (!self.replicaBudgetHealthy() or stream.handler.semantic_failure or self.replica_scheme != null or
+        generation != self.replica_generation or self.replica_sequence == std.math.maxInt(u64) or sequence != self.replica_sequence + 1) return false;
+    self.replica_scheme = .{ .sequence = sequence, .dark = dark };
+    return true;
+}
+
+pub fn replicaSchemeDispatch(self: *Termio, generation: u64, sequence: u64) ?bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const pending = if (self.replica_scheme) |*p| p else return null;
+    if (generation != self.replica_generation or sequence != pending.sequence or pending.dispatched or
+        !self.replicaBudgetHealthy() or self.replica_stream.?.handler.semantic_failure) return null;
+    pending.dispatched = true;
+    return pending.dark;
+}
+
+pub fn replicaSchemeFail(self: *Termio) void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    if (self.replica_stream) |*s| s.handler.semantic_failure = true;
 }
 
+pub fn replicaSchemeState(self: *Termio, generation: u64, dark: *bool, background: *u32) bool {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    const stream = if (self.replica_stream) |*s| s else return false;
+    if (generation != self.replica_generation or !self.replicaBudgetHealthy() or stream.handler.semantic_failure) return false;
+    dark.* = self.config.conditional_state.theme == .dark;
+    const c = self.terminal.colors.background.default orelse return false;
+    background.* = (@as(u32, c.r) << 16) | (@as(u32, c.g) << 8) | c.b;
+    return true;
+}
