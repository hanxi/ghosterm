+// P0 budgeted embedded warmups are owned until destroy, never detached.
+p0_warmups: @import("apprt/p0_warmup.zig").Group = .{},
+
 pub const CreateError = Allocator.Error || font.SharedGridSet.InitError;
 
 /// Create a new app instance. This returns a stable pointer to the app
 /// instance which is required for callbacks.
+pub fn createUnwarmed(alloc: Allocator) CreateError!*App {
+    var app = try alloc.create(App);
+    errdefer alloc.destroy(app);
+    try app.init(alloc);
+    return app;
+}
+
+pub fn startBudgetedWarmups(self: *App, allocator: Allocator, context: ?*anyopaque, observer: @import("apprt/p0_warmup.zig").Observer) !void {
+    if (comptime @hasDecl(font.Discover, "warmup") and @hasDecl(renderer.Device, "warmup")) {
+        try self.p0_warmups.start(allocator, font.Discover.warmup, renderer.Device.warmup, context, observer);
+    } else return error.UnsupportedWarmups;
+}
+
 pub fn create(alloc: Allocator) CreateError!*App {
     var app = try alloc.create(App);
     errdefer alloc.destroy(app);
@@ -134,6 +150,7 @@
