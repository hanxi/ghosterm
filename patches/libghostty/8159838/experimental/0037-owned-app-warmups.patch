new file mode 100644
--- /dev/null
+++ b/src/apprt/p0_warmup.zig
@@ -0,0 +1,83 @@
+// P0: two owned, joinable warmups; partial startup is transactional.
+const std = @import("std");
+const thread = @import("p0_thread.zig");
+pub const Observer = ?*const fn (?*anyopaque, u32, u32) callconv(.c) void;
+pub const Group = struct {
+    context: ?*anyopaque = null,
+    observer: Observer = null,
+    threads: [2]?thread.Thread = .{ null, null },
+    pub fn start(self: *Group, allocator: std.mem.Allocator, comptime first: anytype, comptime second: anytype, context: ?*anyopaque, observer: Observer) !void {
+        std.debug.assert(self.threads[0] == null and self.threads[1] == null);
+        self.context = context;self.observer = observer;
+        errdefer self.join();
+        inline for (.{ first, second }, 0..) |function, i| {
+            const Job = struct {
+                fn run(c: ?*anyopaque, observe: Observer) void {
+                    if (observe) |callback| callback(c, i, 0);
+                    function();
+                    if (observe) |callback| callback(c, i, 1);
+                }
+            };
+            self.threads[i] = try thread.spawn(allocator, .{}, Job.run, .{ context, observer });
+        }
+    }
+    pub fn join(self: *Group) void {
+        for (&self.threads, 0..) |*slot, i| {
+            if (slot.*) |value| {
+                value.join();
+                if (self.observer) |callback| callback(self.context, @intCast(i), 2);
+            }
+            slot.* = null;
+        }
+    }
+};
+test "warmups run and join both entries" {
+    const Job = struct {
+        var completed = std.atomic.Value(u32).init(0);
+        fn run() void { _ = completed.fetchAdd(1, .seq_cst); }
+    };
+    var group = Group{};
+    try group.start(std.testing.allocator, Job.run, Job.run, null, null);
+    for (group.threads) |slot| try std.testing.expect(slot != null);
+    group.join();
+    try std.testing.expectEqual(@as(u32, 2), Job.completed.load(.seq_cst));
+    for (group.threads) |slot| try std.testing.expect(slot == null);
+}
+test "second warmup allocation failure joins the first" {
+    const Job = struct { fn run() void {} };
+    var failing = std.testing.FailingAllocator.init(std.testing.allocator, .{ .fail_index = 1 });
+    var group = Group{};
+    try std.testing.expectError(error.OutOfMemory, group.start(failing.allocator(), Job.run, Job.run, null, null));
+    for (group.threads) |slot| try std.testing.expect(slot == null);
+    try std.testing.expectEqual(failing.allocated_bytes, failing.freed_bytes);
+}
+test "join waits for active warmups" {
+    const Job = struct {
+        var release = std.atomic.Value(bool).init(false);
+        var entered = std.atomic.Value(u32).init(0);
+        fn run() void {
+            _ = entered.fetchAdd(1, .seq_cst);
+            while (!release.load(.seq_cst)) pause(100_000);
+        }
+    };
+    const Joiner = struct {
+        var entered = std.atomic.Value(bool).init(false);
+        var returned = std.atomic.Value(bool).init(false);
+        fn run(g: *Group) void {
+            entered.store(true, .seq_cst);g.join();returned.store(true, .seq_cst);
+        }
+    };
+    var group = Group{};
+    try group.start(std.testing.allocator, Job.run, Job.run, null, null);
+    while (Job.entered.load(.seq_cst) != 2) pause(100_000);
+    const saved = group.threads;
+    const joiner = try std.Thread.spawn(.{}, Joiner.run, .{&group});
+    while (!Joiner.entered.load(.seq_cst)) pause(100_000);
+    pause(30 * std.time.ns_per_ms);
+    const early = Joiner.returned.load(.seq_cst);
+    Job.release.store(true, .seq_cst);joiner.join();
+    if (early) for (saved) |slot| { slot.?.join(); };
+    try std.testing.expect(!early);
+}
+
+fn pause(ns: u64) void { _ = std.c.nanosleep(&.{ .sec = @intCast(ns / std.time.ns_per_s), .nsec = @intCast(ns % std.time.ns_per_s) }, null); }
