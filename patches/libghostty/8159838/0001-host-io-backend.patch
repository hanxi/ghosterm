diff --git a/src/termio/Host.zig b/src/termio/Host.zig
new file mode 100644
index 000000000..9fab3ce14
--- /dev/null
+++ b/src/termio/Host.zig
@@ -0,0 +1,175 @@
+//! Host IO backend: the embedder owns the byte stream (SSH session, local
+//! shell over a socket, ...) and libghostty only does terminal emulation +
+//! rendering.
+//!
+//! Upstream libghostty only ships the `exec` backend, which always forks a
+//! subprocess behind a pty (`termio.Exec`). Embedders that already have their
+//! own transport (e.g. libssh2 as in Ghosterm) have no way to hand bytes in or
+//! take user input out, which is why this exists.
+//!
+//! Data flow (identical shape to `Exec`, minus the pty):
+//!   host  --ghostty_surface_process_output-->  Termio.processOutput  (grid)
+//!   grid  --mailbox write-->  Host.queueWrite  --write_cb-->  host
+//!   host  --ghostty_surface_set_size-->  Host.resize  --resize_cb-->  host
+//!
+//! No subprocess, no read thread, no termios timer. The termio thread still
+//! runs: it drains the mailbox (input, resize, config) and is the only writer
+//! of terminal state from the input side, while the host's own session thread
+//! feeds output through `processOutput`, exactly like Exec's reader thread
+//! does. Both paths take the renderer lock, so they are safe to run
+//! concurrently.
+const Host = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+const ProcessInfo = @import("../pty.zig").ProcessInfo;
+
+const log = std.log.scoped(.io_host);
+
+/// Callbacks into the embedder. All are called from the termio thread.
+pub const Callbacks = struct {
+    /// Opaque pointer passed back to every callback.
+    userdata: ?*anyopaque = null,
+
+    /// User input encoded by the terminal, ready to be written to the
+    /// embedder's transport. Called from the termio thread.
+    write: *const fn (?*anyopaque, [*]const u8, usize) callconv(.c) void,
+
+    /// The terminal grid changed size; the embedder must forward this to its
+    /// transport (SSH window-change / pty resize).
+    resize: *const fn (?*anyopaque, u16, u16) callconv(.c) void,
+};
+
+callbacks: Callbacks,
+
+pub fn init(callbacks: Callbacks) Host {
+    return .{ .callbacks = callbacks };
+}
+
+/// The host has no process to wait for, so there is no thread data.
+pub const ThreadData = struct {
+    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
+        _ = self;
+        _ = alloc;
+    }
+};
+
+/// Nothing to start. The terminal state is already sized from the surface's
+/// initial size by the caller.
+pub fn initTerminal(self: *Host, t: *terminal.Terminal) void {
+    _ = self;
+    _ = t;
+}
+
+pub fn threadEnter(
+    self: *Host,
+    alloc: Allocator,
+    io: *termio.Termio,
+    td: *termio.Termio.ThreadData,
+) !void {
+    _ = self;
+    _ = alloc;
+    _ = io;
+    td.backend = .{ .host = .{} };
+}
+
+pub fn threadExit(self: *Host, td: *termio.Termio.ThreadData) void {
+    _ = self;
+    _ = td;
+}
+
+pub fn deinit(self: *Host) void {
+    _ = self;
+}
+
+/// The host owns focus semantics for its transport; nothing to forward.
+pub fn focusGained(
+    self: *Host,
+    td: *termio.Termio.ThreadData,
+    focused: bool,
+) !void {
+    _ = self;
+    _ = td;
+    _ = focused;
+}
+
+pub fn resize(
+    self: *Host,
+    grid_size: renderer.GridSize,
+    screen_size: renderer.ScreenSize,
+) !void {
+    _ = screen_size;
+    log.debug("host resize cols={} rows={}", .{ grid_size.columns, grid_size.rows });
+    self.callbacks.resize(
+        self.callbacks.userdata,
+        @intCast(grid_size.columns),
+        @intCast(grid_size.rows),
+    );
+}
+
+pub fn queueWrite(
+    self: *Host,
+    alloc: Allocator,
+    td: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    _ = alloc;
+    _ = td;
+    if (data.len == 0) return;
+
+    var buf: [4096]u8 = undefined;
+    if (!linefeed) {
+        self.callbacks.write(self.callbacks.userdata, data.ptr, data.len);
+        return;
+    }
+
+    // Slow path: CR -> CRLF, mirrored from the exec backend so that embedded
+    // hosts get the same linefeed-mode behavior.
+    var i: usize = 0;
+    while (i < data.len) {
+        var buf_i: usize = 0;
+        while (i < data.len and buf_i < buf.len - 1) {
+            const ch = data[i];
+            i += 1;
+            if (ch != '\r') {
+                buf[buf_i] = ch;
+                buf_i += 1;
+                continue;
+            }
+            buf[buf_i] = '\r';
+            buf[buf_i + 1] = '\n';
+            buf_i += 2;
+        }
+        if (buf_i > 0) self.callbacks.write(self.callbacks.userdata, &buf, buf_i);
+    }
+}
+
+/// The host signals abnormal exits itself (it knows its transport); nothing
+/// to synthesize here.
+pub fn childExitedAbnormally(
+    self: *Host,
+    gpa: Allocator,
+    t: *terminal.Terminal,
+    exit_code: u32,
+    runtime_ms: u64,
+) !void {
+    _ = self;
+    _ = gpa;
+    _ = t;
+    _ = exit_code;
+    _ = runtime_ms;
+}
+
+pub fn getProcessInfo(self: *Host, comptime info: ProcessInfo) ?ProcessInfo.Type(info) {
+    _ = self;
+    // Foreground pid / tty name are pty concepts; the host's transport may
+    // have neither. Reporting "unavailable" is the honest answer.
+    return switch (info) {
+        .foreground_pid => null,
+        .tty_name => null,
+    };
+}
