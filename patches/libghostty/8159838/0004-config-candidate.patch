+/// Checked host update. Resolve conditional allocation/parse errors before
+/// changing surfaces. A later surface error propagates to the host, which must
+/// account for a partial update and an explicitly checked restoration attempt.
+pub fn updateConfigChecked(self: *App, rt_app: *apprt.App, config: *const Config) !void {
+    var applied_ = try config.changeConditionalState(self.config_conditional_state);
+    defer if (applied_) |*value| value.deinit();
+    const applied: *const configpkg.Config = if (applied_) |*value| value else config;
+    if (!applied._diagnostics.empty()) return error.InvalidConfiguration;
+    for (self.surfaces.items) |surface| {
+        try surface.core().handleMessage(.{ .change_config = config });
+    }
+    if (!try rt_app.performAction(.app, .config_change, .{ .config = applied })) return error.ConfigUpdateDeclined;
+}
+
 /// Add an initialized surface. This is really only for the runtime
 /// implementations to call and should NOT be called by general app users.
 /// The surface must be from the pool.
