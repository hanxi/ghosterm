+    /// OSC 133（semantic prompt）→ 宿主。映射照抄上游 VT 层
+    /// （stream_terminal.Handler.semanticPrompt）：kind/prompt_kind 的取值与
+    /// 序数一致，`command` 是解码后的命令行，`exit_code` 只在 command_end 有意义。
+    fn semanticPromptHost(self: *StreamHandler, cmd: terminal.osc.Command.SemanticPrompt) void {
+        // 只有 embedded apprt 实现这条；其它 apprt 原样不动。
+        if (comptime @hasDecl(apprt.Surface, "hostSemanticPrompt")) {
+            const Sp = terminal.osc.semantic_prompt;
+            const rt_surface = self.surface_mailbox.surface.rt_surface;
+            if (!rt_surface.hostSemanticPromptEnabled()) return;
+
+            // 序数与 GHOSTTY_SEMANTIC_PROMPT_* 一致（upstream vt/terminal.h）。
+            const kind_invalid: c_int = 0;
+            const kind_prompt_start: c_int = 1;
+            const kind_input_start: c_int = 2;
+            const kind_output_start: c_int = 3;
+            const kind_command_end: c_int = 4;
+
+            var c: Sp.C = .{
+                .size = @sizeOf(Sp.C),
+                .kind = kind_invalid,
+                .prompt_kind = @intFromEnum(Sp.PromptKind.initial),
+                .has_exit_code = false,
+                .exit_code = 0,
+            };
+
+            var cmd_buf: [4096]u8 = undefined;
+            switch (cmd.action) {
+                // 上游 VT 层也不报 fresh_line。
+                .fresh_line => return,
+
+                .fresh_line_new_prompt, .new_command, .prompt_start => {
+                    c.kind = kind_prompt_start;
+                    if (cmd.readOption(.prompt_kind)) |v| c.prompt_kind = @intFromEnum(v);
+                },
+
+                .end_prompt_start_input, .end_prompt_start_input_terminate_eol => {
+                    c.kind = kind_input_start;
+                },
+
+                .end_input_start_output => {
+                    c.kind = kind_output_start;
+                    var w: std.Io.Writer = .fixed(&cmd_buf);
+                    cmd.writeCommandLine(&w) catch {};
+                    const s = w.buffered();
+                    c.command = .{ .ptr = &cmd_buf, .len = s.len };
+                },
+
+                .end_command => {
+                    c.kind = kind_command_end;
+                    if (cmd.readOption(.exit_code)) |code| {
+                        c.has_exit_code = true;
+                        c.exit_code = code;
+                    }
+                    const err = cmd.readOption(.err) orelse "";
+                    c.err = .{ .ptr = err.ptr, .len = err.len };
+                },
+            }
+
+            rt_surface.hostSemanticPrompt(&c);
+        }
+    }
