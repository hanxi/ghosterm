diff --git a/src/terminal/osc/parsers/program_status.zig b/src/terminal/osc/parsers/program_status.zig
index c9e5926da..1c5f205a8 100644
--- a/src/terminal/osc/parsers/program_status.zig
+++ b/src/terminal/osc/parsers/program_status.zig
@@ -140,6 +140,43 @@ pub const Command = union(enum) {
     report: program_status.Report,
 };
 
+/// A program status report in the form an embedder receives it across the
+/// C ABI (see patches/libghostty/8159838/0002-program-status.patch).
+///
+/// This is a sized struct: a later revision of the protocol may add fields at
+/// the end, so read `size` first and only touch the fields it covers. Every
+/// field below has been present since the struct was introduced.
+///
+/// The strings borrow memory that only lives for the duration of the call
+/// that delivers the report. They are never null; a value the program did not
+/// send is an empty string. `title` and `message` are already decoded from
+/// base64.
+///
+/// `state` and `kind` use the same ordinals as upstream's
+/// `GhosttyProgramStatusState` / `GhosttyProgramStatusKind` in
+/// include/ghostty/vt/terminal.h, so the two C surfaces agree.
+pub const C = extern struct {
+    size: usize,
+    state: c_int,
+    kind: c_int,
+    progress: i8,
+    id: String,
+    app: String,
+    title: String,
+    message: String,
+
+    /// A borrowed byte string. Sync with: ghostty_string_s in
+    /// include/ghostty.h.
+    pub const String = extern struct {
+        ptr: ?[*]const u8 = null,
+        len: usize = 0,
+
+        /// True when `ptr` is NUL-terminated. Our strings are bounded
+        /// slices, so this is always false.
+        sentinel: bool = false,
+    };
+};
+
 /// The value of the required `state` key.
 ///
 /// - `idle`: at rest, waiting for the user's next instruction.
