             .clipboard_contents => try self.clipboardContents(value.kind, value.data),
             .semantic_prompt => try self.semanticPrompt(value),
@@ -389,7 +395,6 @@ pub const StreamHandler = struct {
             .title_pop,
             .kitty_dnd,
