-            .program_status,
             => {},
         }
     }
@@ -1946,6 +1951,69 @@ pub const StreamHandler = struct {
     fn progressReport(self: *StreamHandler, report: terminal.osc.Command.ProgressReport) void {
         self.surfaceMessageWriter(.{ .progress_report = report });
     }
+
+    /// Program status protocol (OSC 7501). See patches/libghostty/8159838.
+    ///
+    /// The terminal keeps no records. A valid report goes straight to the
+    /// embedder through the apprt's callback, on this thread and only while
+    /// the parser's memory is valid; the support query is answered inline.
+    /// A query is answered only while an embedder is listening, so a program
+    /// can tell a terminal that implements the protocol from one that does
+    /// not.
+    fn programStatus(self: *StreamHandler, cmd: terminal.osc.Command.ProgramStatus) void {
+        // Only the embedded apprt implements this today; every other apprt
+        // leaves the arm a no-op, so the terminal claims no support.
+        if (comptime @hasDecl(apprt.Surface, "hostProgramStatus")) {
+            const ps = terminal.osc.program_status;
+            const rt_surface = self.surface_mailbox.surface.rt_surface;
+
+            switch (cmd) {
+                // A valid report. `title`/`message` arrive base64-encoded, so
+                // decode them; the other strings stay borrowed (they are valid
+                // for this call, and the callback runs synchronously).
+                .report => |report| {
+                    var title_buf: [ps.max_title_bytes]u8 = undefined;
+                    var title_writer: std.Io.Writer = .fixed(&title_buf);
+                    report.writeText(.title, &title_writer) catch {};
+
+                    var msg_buf: [ps.max_msg_bytes]u8 = undefined;
+                    var msg_writer: std.Io.Writer = .fixed(&msg_buf);
+                    report.writeText(.msg, &msg_writer) catch {};
+
+                    const id = report.readOption(.id) orelse "";
+                    const app = report.readOption(.app) orelse "";
+
+                    // state/kind keep upstream's C ordinals (kind has no
+                    // "none" in Zig, so +1 to reach GHOSTTY_PROGRAM_STATUS_KIND_*).
+                    const c: ps.C = .{
+                        .size = @sizeOf(ps.C),
+                        .state = @intFromEnum(report.state),
+                        .kind = if (report.readOption(.kind)) |k| @intFromEnum(k) + 1 else 0,
+                        .progress = if (report.readOption(.progress)) |p| @intCast(p) else -1,
+                        .id = .{ .ptr = id.ptr, .len = id.len },
+                        .app = .{ .ptr = app.ptr, .len = app.len },
+                        .title = .{ .ptr = &title_buf, .len = title_writer.buffered().len },
+                        .message = .{ .ptr = &msg_buf, .len = msg_writer.buffered().len },
+                    };
+
+                    rt_surface.hostProgramStatus(&c);
+                },
+
+                // The program asked whether the terminal implements the
+                // protocol. Answer with the states and kinds we accept, ended
+                // with the same terminator the program used. Stay silent when
+                // nobody is listening.
+                .query => |terminator| {
+                    if (!rt_surface.hostProgramStatusEnabled()) return;
+                    const reply: []const u8 = switch (terminator) {
+                        .st => program_status_reply_st,
+                        .bel => program_status_reply_bel,
+                    };
+                    self.messageWriter(.{ .write_stable = reply });
+                },
+            }
+        }
+    }
 };
 
