@@ -20,6 +20,11 @@ const log = std.log.scoped(.io_handler);
 /// stateful and is expected to live for the entire lifetime of the terminal.
 /// It is NOT VALID to stop a stream handler, create a new one, and use that
 /// unless all of the member fields are copied.
+/// The reply to an OSC 7501 support query, ended to match the terminator the
+/// program used. See the Program Status Protocol specification.
+const program_status_reply_st = "\x1b]7501;" ++ terminal.osc.program_status.query_reply ++ "\x1b\\";
+const program_status_reply_bel = "\x1b]7501;" ++ terminal.osc.program_status.query_reply ++ "\x07";
+
