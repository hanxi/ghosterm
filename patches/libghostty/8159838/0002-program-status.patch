+// Program status protocol (OSC 7501). Ghosterm patch: the embedder opts in
+// through ghostty_surface_config_s.host_program_status. See
+// patches/libghostty/8159838/0002-program-status.patch. The strings below use
+// the ghostty_string_s already declared in this header.
+//
+// What the program is doing. Same ordinals as GhosttyProgramStatusState in
+// include/ghostty/vt/terminal.h.
+typedef enum {
+  GHOSTTY_PROGRAM_STATUS_STATE_IDLE = 0,
+  GHOSTTY_PROGRAM_STATUS_STATE_WORKING = 1,
+  GHOSTTY_PROGRAM_STATUS_STATE_DONE = 2,
+  GHOSTTY_PROGRAM_STATUS_STATE_BLOCKED = 3,
+  GHOSTTY_PROGRAM_STATUS_STATE_ERROR = 4,
+  GHOSTTY_PROGRAM_STATUS_STATE_CLEAR = 5,
+} ghostty_program_status_state_e;
+
+// What a blocked program needs. Same ordinals as GhosttyProgramStatusKind.
+typedef enum {
+  GHOSTTY_PROGRAM_STATUS_KIND_NONE = 0,
+  GHOSTTY_PROGRAM_STATUS_KIND_PERMISSION = 1,
+  GHOSTTY_PROGRAM_STATUS_KIND_QUESTION = 2,
+  GHOSTTY_PROGRAM_STATUS_KIND_AUTH = 3,
+} ghostty_program_status_kind_e;
+
+// A program status report. Sized struct: read `size` first and only touch the
+// fields it covers, so fields may be appended in a later version. The strings
+// are borrowed and are only valid during the callback; they are never NULL, an
+// absent value is an empty string. `title`/`message` are already decoded.
+typedef struct {
+  size_t size;
+  ghostty_program_status_state_e state;
+  ghostty_program_status_kind_e kind;
+  int8_t progress;  // 0..100, or -1 for indeterminate / not applicable
+  ghostty_string_s id;
+  ghostty_string_s app;
+  ghostty_string_s title;
+  ghostty_string_s message;
+} ghostty_program_status_s;
+
+typedef void (*ghostty_host_program_status_fn)(void*, const ghostty_program_status_s*);
+
