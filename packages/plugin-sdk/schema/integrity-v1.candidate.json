{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghosterm.invalid/plugin-schema/integrity-v1.candidate.json",
  "$comment": "Candidate content index. integrity.json and signature are excluded from members to avoid self-reference; they still count against physical budgets. No publisher authentication implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "members"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "https://ghosterm.invalid/plugin-schema/manifest-v1.candidate.json#/$defs/packagePath"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "sha256": {
            "$ref": "https://ghosterm.invalid/plugin-schema/bridge-v1.candidate.json#/$defs/digest"
          }
        }
      }
    }
  }
}
