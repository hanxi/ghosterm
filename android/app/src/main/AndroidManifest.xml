<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:name=".GhostermApplication" android:allowBackup="false" android:label="Ghosterm"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true" android:theme="@style/Theme.Ghosterm"
        android:usesCleartextTraffic="false">
        <provider android:name=".ExternalPreviewProvider" android:authorities="${applicationId}.previews"
            android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".FileTransferService" android:exported="false"
            android:foregroundServiceType="dataSync" android:stopWithTask="false" />
        <receiver android:name=".FileTransferActions" android:exported="false" />
        <service android:name=".TerminalConnectionService" android:exported="false"
            android:foregroundServiceType="specialUse" android:stopWithTask="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintain user-initiated interactive local and SSH terminal connections while the user switches apps or locks the screen; no automatic reconnection after process death." />
        </service>
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
