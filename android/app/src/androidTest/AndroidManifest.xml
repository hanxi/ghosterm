<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider android:name="com.hanxi.ghosterm.PreviewAssetsProvider"
            android:authorities="com.hanxi.ghosterm.test.previewassets"
            android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <activity android:name="com.hanxi.ghosterm.PreviewReceiverActivity" android:exported="true" android:label="Ghosterm Preview Test">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <provider android:name="com.hanxi.ghosterm.PreviewReceiverControl"
            android:authorities="com.hanxi.ghosterm.test.previewcontrol" android:exported="true" />
        <provider android:name="com.hanxi.ghosterm.FixtureDocumentsProvider"
            android:authorities="com.hanxi.ghosterm.test.documents"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <provider android:name="com.hanxi.ghosterm.IdentityDocumentsProvider"
            android:authorities="com.hanxi.ghosterm.test.keys"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <provider android:name="com.hanxi.ghosterm.IdentityFixtureControlProvider"
            android:authorities="com.hanxi.ghosterm.test.keycontrol"
            android:exported="true" />
        <provider android:name="com.hanxi.ghosterm.FilesDocumentsProvider"
            android:authorities="com.hanxi.ghosterm.test.browser"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <provider android:name="com.hanxi.ghosterm.PublicationDocumentsProvider"
            android:authorities="com.hanxi.ghosterm.test.publication"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <provider android:name="com.hanxi.ghosterm.PublicationFixtureControlProvider"
            android:authorities="com.hanxi.ghosterm.test.publicationcontrol" android:exported="true" />
    </application>
</manifest>
