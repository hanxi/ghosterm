{
  "schemaVersion": 1,
  "id": "org.ghosterm.table",
  "pluginVersion": "0.1.0",
  "sdkApiRange": "^1.0.0",
  "bridgeProtocolRange": [1],
  "publisher": "Ghosterm",
  "license": "MIT",
  "commands": [{ "path": ["table"], "title": "Paged number powers", "argsSchema": "schemas/table.json", "views": ["table"] }],
  "client": { "runtime": "portable-js", "entry": "client/index.js", "requires": ["session.rpc", "ui.table"] },
  "executor": { "variants": [{ "id": "portable", "runtime": "portable-js", "entry": "executor/index.js", "requires": ["session.rpc"] }] },
  "permissions": [
    { "side": "client", "capability": "session.rpc", "purpose": "Request only the selected read-only table pages.", "scope": "instance" },
    { "side": "client", "capability": "ui.table", "purpose": "Display a bounded Native standard table.", "scope": "instance" },
    { "side": "executor", "capability": "session.rpc", "purpose": "Answer bounded read-only page queries for this invocation.", "scope": "instance" }
  ]
}
