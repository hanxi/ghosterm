{
  "schemaVersion": 1,
  "id": "org.ghosterm.form",
  "pluginVersion": "0.1.0",
  "sdkApiRange": "^1.0.0",
  "bridgeProtocolRange": [1],
  "publisher": "Ghosterm",
  "license": "MIT",
  "commands": [{ "path": ["form"], "title": "Try a plugin form", "argsSchema": "schemas/form.json" }],
  "client": { "runtime": "portable-js", "entry": "client/index.js", "requires": ["session.rpc", "ui.form"] },
  "executor": { "variants": [{ "id": "portable", "runtime": "portable-js", "entry": "executor/index.js", "requires": ["session.rpc"] }] },
  "permissions": [
    { "side": "client", "capability": "session.rpc", "purpose": "Return the answer to the invoking Executor.", "scope": "instance" },
    { "side": "client", "capability": "ui.form", "purpose": "Present one sample form in the current plugin pane.", "scope": "instance" },
    { "side": "executor", "capability": "session.rpc", "purpose": "Request the sample form and receive its answer.", "scope": "instance" }
  ]
}
