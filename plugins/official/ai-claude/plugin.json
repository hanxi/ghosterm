{
  "schemaVersion": 1, "id": "org.ghosterm.ai-claude", "pluginVersion": "0.1.0",
  "sdkApiRange": "^1.0.0", "bridgeProtocolRange": [1], "publisher": "Ghosterm", "license": "MIT",
  "commands": [{ "path": ["ai", "claude"], "title": "Claude SDK bridge (candidate)", "argsSchema": "schemas/command.json" }],
  "client": { "runtime": "portable-js", "entry": "client/index.js", "requires": ["session.rpc"] },
  "executor": { "variants": [{ "id": "portable-node-supervisor", "runtime": "portable-js", "entry": "executor/index.js",
    "requires": ["session.rpc", "process.spawn", "process.pipes"] }] },
  "permissions": [
    { "side": "client", "capability": "session.rpc", "purpose": "Observe the candidate Claude backend bridge through Native Host RPC.", "scope": "instance" },
    { "side": "executor", "capability": "session.rpc", "purpose": "Receive scoped explicit actions and retain bounded complete backend receipts.", "scope": "instance" },
    { "side": "executor", "capability": "process.spawn", "programs": ["claude-node"],
      "purpose": "Run only the Host-mapped Node >=20 component with fixed owner-selected entry/profile, SDK 0.3.323 and CLI 2.1.323; no automatic dependency installation.", "scope": "instance" },
    { "side": "executor", "capability": "process.pipes", "purpose": "Exchange bounded private SDK commands and reap the scoped Node process on shutdown.", "scope": "instance" }
  ]
}
