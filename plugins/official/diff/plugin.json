{
  "schemaVersion": 1,
  "id": "org.ghosterm.diff",
  "pluginVersion": "0.1.0",
  "sdkApiRange": "^1.0.0",
  "bridgeProtocolRange": [1],
  "publisher": "Ghosterm",
  "license": "MIT",
  "commands": [{ "path": ["diff"], "title": "Read-only text comparison", "argsSchema": "schemas/diff.json", "views": ["diff"] }],
  "client": { "runtime": "portable-js", "entry": "client/index.js", "requires": ["session.rpc", "ui.diff"] },
  "executor": { "variants": [{ "id": "portable", "runtime": "portable-js", "entry": "executor/index.js", "requires": ["session.rpc"] }] },
  "permissions": [
    { "side": "client", "capability": "session.rpc", "purpose": "Read the selected comparison pages.", "scope": "instance" },
    { "side": "client", "capability": "ui.diff", "purpose": "Display read-only Native comparison rows and exact line endings.", "scope": "instance" },
    { "side": "executor", "capability": "session.rpc", "purpose": "Compute and serve this bounded text comparison.", "scope": "instance" }
  ]
}
