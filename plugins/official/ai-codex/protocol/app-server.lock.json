{
  "format": 1,
  "codexCliVersion": "codex-cli 0.166.0",
  "experimentalApi": false,
  "clientRequests": [
    "initialize",
    "thread/start",
    "turn/start",
    "turn/interrupt"
  ],
  "clientNotifications": [
    "initialized"
  ],
  "serverRequests": [
    "item/commandExecution/requestApproval",
    "item/fileChange/requestApproval"
  ],
  "serverNotifications": [
    "turn/started",
    "turn/completed",
    "item/started",
    "item/completed",
    "item/agentMessage/delta",
    "item/commandExecution/outputDelta",
    "item/fileChange/patchUpdated",
    "serverRequest/resolved"
  ],
  "requiredFields": {
