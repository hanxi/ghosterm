#!/usr/bin/env python3
"""Lua plugin development and release commands."""
import argparse
import ctypes
import errno
import hashlib
import json
import math
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import tempfile
import unicodedata
import zipfile

TOOLS = Path(__file__).resolve().parent
ROOT = TOOLS.parent
REPOSITORY = (ROOT / 'AGENTS.md').is_file()
TMP = ROOT / 'tmp' if REPOSITORY else Path(tempfile.gettempdir())
sys.dont_write_bytecode = True

from plugin_lua_manifest import MAX_SOURCE_BYTES, extract_manifest, release_manifest


class Failure(Exception):
    def __init__(self, code, status=2):
        super().__init__(code)
        self.status = status


def require(condition, code, status=2):
    if not condition:
        raise Failure(code, status)


def pairs(items):
    result = {}
    for key, value in items:
        require(key not in result and key not in ('__proto__', 'prototype', 'constructor'), 'DUPLICATE_OR_RESERVED_KEY')
        result[key] = value
    return result


def decode(data):
    require(len(data) <= 131072, 'JSON_LIMIT')
    text = data.decode('utf-8', errors='strict')
    try:
        result = json.loads(text, object_pairs_hook=pairs, parse_constant=lambda _: (_ for _ in ()).throw(Failure('JSON_NUMBER')))
    except RecursionError:
        raise Failure('JSON_DEPTH') from None
    def valid(value, depth=0):
        require(depth <= 32, 'JSON_DEPTH')
        if isinstance(value, str):
            value.encode('utf-8', errors='strict')
        elif isinstance(value, float):
            require(math.isfinite(value), 'JSON_NUMBER')
        elif isinstance(value, list):
            for child in value:
                valid(child, depth + 1)
        elif isinstance(value, dict):
            for key, child in value.items():
                valid(key, depth + 1)
                valid(child, depth + 1)
    valid(result)
    return result


def encoded(value):
    return json.dumps(value, ensure_ascii=False, separators=(',', ':'), allow_nan=False).encode('utf-8')


def sha(data):
    return hashlib.sha256(data).hexdigest()


def read_json(filename):
    fd = os.open(filename, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
    try:
        before = os.fstat(fd)
        require(stat.S_ISREG(before.st_mode) and before.st_size <= 131072, 'JSON_FILE')
        data = b''
        while len(data) <= before.st_size:
            chunk = os.read(fd, before.st_size + 1 - len(data))
            if not chunk:
                break
            data += chunk
        after = os.fstat(fd)
        require((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) ==
                (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns) and len(data) == before.st_size, 'SOURCE_CHANGED')
        return decode(data)
    finally:
        os.close(fd)


def member(name):
    require(isinstance(name, str) and 0 < len(name) <= 1024 and name == unicodedata.normalize('NFC', name) and
            not any(ord(c) < 32 or ord(c) == 127 or c in '\\:' for c in name) and
            all(p and p not in ('.', '..') and not p.endswith(('.', ' ')) for p in name.split('/')), 'MEMBER_PATH')
    name.encode('utf-8', errors='strict')
    return name


def read_member(name, owner, device, limit):
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=owner)
    try:
        before = os.fstat(fd)
        require(stat.S_ISREG(before.st_mode) and before.st_dev == device, 'NONREGULAR_MEMBER')
        require(before.st_size <= limit, 'PACKAGE_LIMIT')
        chunks = []
        remaining = before.st_size + 1
        while remaining:
            chunk = os.read(fd, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b''.join(chunks)
        after = os.fstat(fd)
        require((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) ==
                (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns) and
                len(data) == before.st_size, 'SOURCE_CHANGED')
        return data
    finally:
        os.close(fd)


def capture(directory, destination, project=False):
    """Pin a physical root, walk via dirfds and read stable regular-file handles."""
    rootfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    observed = {}
    folded = set()
    entries = total = 0
    try:
        device = os.fstat(rootfd).st_dev
        for parent, dirs, files, owner in os.fwalk('.', topdown=True, follow_symlinks=False, dir_fd=rootfd):
            if project:
                dirs[:] = [n for n in dirs if n not in ('.git', 'node_modules')]
            entries += len(dirs) + len(files)
            require(entries <= 4096 and len(Path(parent).parts) <= 32, 'TREE_LIMIT')
            require(os.fstat(owner).st_dev == device, 'MOUNT_BOUNDARY')
            for name in dirs:
                require(stat.S_ISDIR(os.stat(name, dir_fd=owner, follow_symlinks=False).st_mode), 'NONPHYSICAL_DIRECTORY')
            for name in sorted(files):
                relative = member((Path(parent) / name).as_posix())
                require(relative.lower() not in folded, 'CASE_COLLISION')
                folded.add(relative.lower())
                require(len(observed) < 1024, 'PACKAGE_LIMIT')
                data = read_member(name, owner, device, 16777216)
                total += len(data)
                require(total <= 67108864, 'PACKAGE_LIMIT')
                if relative.endswith('.json'):
                    decode(data)
                target = destination / relative
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(data)
                observed[relative] = data
    finally:
        os.close(rootfd)
    return observed


def scratch_root():
    requested = Path(os.environ.get('TMPDIR', TMP)).resolve()
    return requested if requested.is_dir() and requested.is_relative_to(TMP.resolve()) else TMP


def run(command, seconds=60, cooperative=False):
    scratch = str(scratch_root())
    env = dict(os.environ, TMPDIR=scratch, TMP=scratch, TEMP=scratch)
    if sys.platform == 'darwin' and 'DEVELOPER_DIR' not in env and Path('/Applications/Xcode.app/Contents/Developer').is_dir():
        env['DEVELOPER_DIR'] = '/Applications/Xcode.app/Contents/Developer'
    # The shared timeout kills descendants; communicate() alone cannot do so.
    bounded = ['bash', '-c', '. "$1/lib/gt-timeout.sh"; gt_timeout_require plugin-dev; shift; exec "$gt_timeout_bin" "$@"',
               'plugin-dev', TOOLS, seconds, *command]
    process = subprocess.Popen(list(map(str, bounded)), stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, start_new_session=True)
    try:
        output, diagnostics = process.communicate(timeout=seconds + 5)
    finally:
        if process.poll() is None and cooperative:
            try:
                os.killpg(process.pid, signal.SIGTERM)
                process.wait(timeout=3)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                pass
        if process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
    if process.returncode:
        # Compiler/Native diagnostics belong on stderr, never mixed into JSON stdout.
        sys.stderr.buffer.write(diagnostics[-16384:])
        sys.stderr.buffer.write(output[-16384:])
        raise Failure('TOOL_FAILED', 1)
    return output


def publish(stage, destination):
    destination = Path(destination).absolute()
    require(not destination.exists() and not destination.is_symlink(), 'OUTPUT_EXISTS')
    destination.parent.mkdir(parents=True, exist_ok=True)
    # Publication never replaces an existing path; cross-device publication fails.
    if stage.is_dir():
        libc = ctypes.CDLL(None, use_errno=True)
        if sys.platform == 'darwin' and hasattr(libc, 'renamex_np'):
            operation = libc.renamex_np
            operation.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
            result = operation(os.fsencode(stage), os.fsencode(destination), 4)  # RENAME_EXCL
        elif sys.platform.startswith('linux') and hasattr(libc, 'renameat2'):
            operation = libc.renameat2
            operation.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
            result = operation(-100, os.fsencode(stage), -100, os.fsencode(destination), 1)  # NOREPLACE
        else:
            raise Failure('ATOMIC_PUBLISH_UNSUPPORTED', 4)
        if result:
            number = ctypes.get_errno()
            if number == errno.EEXIST:
                raise Failure('OUTPUT_EXISTS')
            raise OSError(number, os.strerror(number))
    else:
        try:
            os.link(stage, destination, follow_symlinks=False)
        except FileExistsError as error:
            raise Failure('OUTPUT_EXISTS') from error


def scaffold(destination, plugin_id, command, publisher):
    require(re.fullmatch(r'[a-z][a-z0-9-]*(?:\.[a-z][a-z0-9-]*)+', plugin_id) and len(plugin_id) <= 128, 'PLUGIN_ID')
    require(re.fullmatch(r'[a-z][a-z0-9-]{0,63}', command) and command not in ('plugin', 'doctor', 'relay'), 'COMMAND')
    require(0 < len(publisher) <= 128 and not any(ord(char) < 32 or ord(char) == 127 for char in publisher), 'PUBLISHER')
    quoted_publisher = json.dumps(publisher, ensure_ascii=False)
    entry = f'''local manifest = {{
  id = "{plugin_id}",
  version = "0.1.0",
  api = "1",
  publisher = {quoted_publisher},
  license = "MIT",
  client = {{ requires = {{}} }},
  commands = {{
    {{ path = {{ "{command}" }}, title = "{command}" }},
  }},
}}

return {{
  ["{command}"] = function()
    return true
  end,
}}
'''.encode('utf-8')
    with tempfile.TemporaryDirectory(prefix='plugin-init-', dir=scratch_root()) as directory:
        stage = Path(directory) / 'project'
        stage.mkdir()
        (stage / 'main.lua').write_bytes(entry)
        publish(stage, destination)
    return dict(kind='initialized', id=plugin_id, path=str(destination.absolute()), installation=False)


def main():
    TMP.mkdir(exist_ok=True)
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='action', required=True)
    manifest = commands.add_parser('lua-manifest', help='Read the static declaration from a Lua entry')
    manifest.add_argument('entry', type=Path)
    for name, aliases, help_text in (
        ('check', [], 'Check the static Lua package declaration'),
        ('build', ['lua-build'], 'Build a Lua package from its static declaration'),
        ('pack', ['lua-pack'], 'Build a deterministic Lua ZIP artifact'),
    ):
        operation = commands.add_parser(name, aliases=aliases, help=help_text)
        operation.set_defaults(action=name)
        operation.add_argument('project', type=Path, help='Project directory or standalone .lua source')
        if name == 'check':
            operation.add_argument('--host-json', type=Path)
        else:
            operation.add_argument('--out', type=Path, required=True)
    init = commands.add_parser('init'); init.add_argument('directory', type=Path); init.add_argument('--id', required=True); init.add_argument('--command', required=True); init.add_argument('--publisher', required=True)
    test = commands.add_parser('test', help='Run a Lua command in a local Core Session')
    test.add_argument('project', type=Path, help='Project directory or standalone .lua source')
    test.add_argument('--core-build', required=True, type=Path)
    test.add_argument('--command', required=True)
    test.add_argument('--paired', action='store_true', help='Start both declared Lua roles')
    test.add_argument('--arg', action='append', default=[], help='Command argument, repeated in order')
    release = commands.add_parser('release', help='candidate offline signed releases; no installation')
    release_commands = release.add_subparsers(dest='release_action', required=True)
    channel = release_commands.add_parser('verify-policy', help='verify a candidate channel snapshot')
    channel.add_argument('--channel', required=True)
    channel.add_argument('--channel-root', required=True, help='explicit trusted raw Ed25519 key in canonical base64')
    channel.add_argument('--statement', type=Path, required=True)
    channel.add_argument('--signature', type=Path, required=True)
    channel.add_argument('--policy', type=Path, required=True)
    channel.add_argument('--record-state', type=Path, help='explicit local database for generation and clock checks')
    sign_policy = release_commands.add_parser('sign-policy', help='sign and stage a channel policy directory')
    sign_policy.add_argument('--channel', required=True)
    sign_policy.add_argument('--channel-root', required=True, help='raw Ed25519 public root in canonical base64')
    sign_policy.add_argument('--policy', type=Path, required=True)
    sign_policy.add_argument('--generation', required=True)
    sign_policy.add_argument('--issued-at', required=True, help='UTC Unix seconds')
    sign_policy.add_argument('--expires-at', required=True, help='UTC Unix seconds')
    sign_policy.add_argument('--signer-json', type=Path, required=True, help='explicit external channel signer')
    sign_policy.add_argument('--out', type=Path, required=True)
    for name in ('sign', 'verify'):
        command = release_commands.add_parser(name)
        command.add_argument('--artifact', type=Path, required=True)
        command.add_argument('--policy', type=Path, required=True, help='explicit trusted channel public-key policy')
        command.add_argument('--host-json', type=Path)
        if name == 'sign':
            command.add_argument('--key-id', required=True)
            command.add_argument('--signer-json', type=Path, required=True, help='explicit external signer; private keys stay outside this tool')
            command.add_argument('--out', type=Path, required=True)
        else:
            command.add_argument('--descriptor', type=Path, required=True)
            command.add_argument('--signature', type=Path, required=True)
            command.add_argument('--channel', help='expected channel for a signed policy statement')
            command.add_argument('--channel-root')
            command.add_argument('--policy-statement', type=Path)
            command.add_argument('--policy-signature', type=Path)
            command.add_argument('--record-state', type=Path)
    args = parser.parse_args()
    if args.action == 'lua-manifest':
        require(args.entry.is_file() and args.entry.suffix == '.lua', 'LUA_ENTRY_FILE')
        with args.entry.open('rb') as stream:
            return extract_manifest(stream.read(MAX_SOURCE_BYTES + 1)), 0
    if args.action in ('check', 'build', 'pack', 'test'):
        if args.action in ('build', 'pack'):
            project, output = args.project.resolve(), args.out.resolve()
            require(not project.is_relative_to(output) and not output.is_relative_to(project),
                    'OUTPUT_SOURCE_OVERLAP')
        with tempfile.TemporaryDirectory(prefix='plugin-lua-build-', dir=scratch_root()) as directory:
            work = Path(directory)
            snapshot, package = work / 'snapshot', work / 'package'
            snapshot.mkdir()
            package.mkdir()
            if args.project.suffix == '.lua' and not args.project.is_dir():
                owner = os.open(args.project.parent, os.O_RDONLY | os.O_DIRECTORY |
                                os.O_NOFOLLOW | os.O_CLOEXEC)
                try:
                    files = {'main.lua': read_member(args.project.name, owner,
                                                     os.fstat(owner).st_dev, MAX_SOURCE_BYTES)}
                finally:
                    os.close(owner)
            else:
                files = capture(args.project, snapshot, project=True)
            require('main.lua' in files, 'LUA_ENTRY_FILE')
            metadata, paths = release_manifest(files['main.lua'], files, member)
            generated = {'manifest.json': encoded(metadata)}
            for path in paths:
                generated[path] = files[path]
            integrity = {
                'schemaVersion': 1,
                'members': [{'path': path, 'bytes': len(data), 'sha256': sha(data)}
                            for path, data in sorted(generated.items())],
            }
            generated['integrity.json'] = encoded(integrity)
            for path, data in generated.items():
                target = package / path
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(data)
            if args.action == 'check':
                from plugin_release import checked_lua_archive
                host = read_json(args.host_json) if args.host_json else None
                _, compatibility = checked_lua_archive(sys.modules[__name__], package, host)
                return {'kind': 'checked', 'manifest': metadata, 'compatibility': compatibility,
                        'packageSHA256': sha(generated['integrity.json'])}, 0
            if args.action == 'test':
                from plugin_release import checked_lua_archive
                sides = ('client', 'executor') if args.paired else ('client',)
                methods = []
                for side in sides:
                    host = dict(side=side, sdkVersion='1.0.0', protocols=[1], runtimes=['lua'],
                                capabilities=['session.rpc'])
                    checked_lua_archive(sys.modules[__name__], package, host)
                    methods.extend(('C:' if side == 'client' else 'E:') + name
                                   for name in metadata[side].get('rpc', []))
                if args.paired:
                    require(len(methods) <= 16 and len({method[2:] for method in methods}) == len(methods),
                            'TEST_PAIR_METHODS')
                require(any(' '.join(command['path']) == args.command for command in metadata['commands']),
                        'TEST_COMMAND')
                core = args.core_build.resolve(strict=True)
                probe = core / 'test_lua_client'
                require(probe.is_file() and os.access(probe, os.X_OK), 'TEST_REQUIRES_LUA_CLIENT_BINARY')
                mode = 'paired' if args.paired else 'client'
                negotiated = [*methods, '--'] if args.paired else []
                result = subprocess.run([probe, mode, package, args.command, *negotiated, *args.arg],
                                        cwd=work, capture_output=True, timeout=15)
                if result.returncode:
                    sys.stderr.buffer.write(result.stderr)
                    raise Failure('TEST_CLIENT_ACTIVATION', 5)
                return {'kind': 'tested', 'side': mode, 'command': args.command,
                        'packageSHA256': sha(generated['integrity.json'])}, 0
            if args.action == 'pack':
                archive = work / 'package.zip'
                with zipfile.ZipFile(archive, 'w', compression=zipfile.ZIP_STORED,
                                     allowZip64=False) as zipped:
                    for path, data in sorted(generated.items()):
                        info = zipfile.ZipInfo(path, date_time=(1980, 1, 1, 0, 0, 0))
                        info.create_system = 3
                        info.external_attr = 0o100644 << 16
                        zipped.writestr(info, data)
                digest = sha(archive.read_bytes())
                publish(archive, args.out)
                return {'kind': 'packed', 'output': str(args.out.absolute()), 'sha256': digest}, 0
            publish(package, args.out)
        return {'kind': 'built', 'output': str(args.out.absolute()),
                'packageSHA256': sha(generated['integrity.json'])}, 0
    if args.action == 'init': return scaffold(args.directory, args.id, args.command, args.publisher), 0
    if args.action == 'release':
        import plugin_release
        return plugin_release.execute(args, sys.modules[__name__])


if __name__ == '__main__':
    def interrupted(number, _frame):
        raise SystemExit(128 + number)
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        result, status = main()
    except (Failure, OSError, ValueError, UnicodeError, TypeError, KeyError, subprocess.SubprocessError) as error:
        result, status = dict(kind='error', code=str(error)), getattr(error, 'status', 2)
    print(encoded(result).decode())
    raise SystemExit(status)
